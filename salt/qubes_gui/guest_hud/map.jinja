{# OS integration points. Theme payload paths are FHS-compatible. #}
{% set unsupported_platform = {
  'supported': false,
  'packages': [],
  'early_session': '',
  'late_session': '',
  'session_mode': '0644',
  'session_directories': []
} %}
{% if grains.get('os_family', '') == 'Debian' %}
  {% set guest_hud_platform = {
    'supported': true,
    'packages': ['dconf-cli', 'fonts-noto-core', 'fonts-noto-mono'],
    'early_session': '/etc/X11/Xsession.d/59qubes-hud-xdg',
    'late_session': '/etc/X11/Xsession.d/90qubes-hud-qt',
    'session_mode': '0644',
    'session_directories': ['/etc/X11', '/etc/X11/Xsession.d']
  } %}
{% elif grains.get('os', '') == 'Fedora' %}
  {% set guest_hud_platform = {
    'supported': true,
    'packages': ['dconf', 'google-noto-sans-vf-fonts',
                 'google-noto-sans-mono-vf-fonts'],
    'early_session': '/etc/X11/xinit/xinitrc.d/59-qubes-hud-xdg.sh',
    'late_session': '/etc/X11/xinit/xinitrc.d/90-qubes-hud-qt.sh',
    'session_mode': '0755',
    'session_directories': ['/etc/X11', '/etc/X11/xinit',
                            '/etc/X11/xinit/xinitrc.d']
  } %}
{% else %}
  {% set guest_hud_platform = unsupported_platform %}
{% endif %}
