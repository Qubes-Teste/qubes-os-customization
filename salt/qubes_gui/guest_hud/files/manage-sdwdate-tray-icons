@dataclass(frozen=True)
class IconSpec:
    """One package path and the deterministic HUD artwork replacing it."""

    name: str
    size: int
    color: tuple[int, int, int]
    glyph: str

    @property
    def target(self) -> Path:
        return ICON_ROOT / self.name

    @property
    def diverted(self) -> Path:
        return self.target.with_name(self.target.name + ".qubes-hud-original")


ICON_SPECS = (
    IconSpec("error.png", 48, ALERT, "error"),
    IconSpec("sdwdate-stopped.png", 32, ALERT, "stopped"),
