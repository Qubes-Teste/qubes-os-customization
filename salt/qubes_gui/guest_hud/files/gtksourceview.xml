<?xml version="1.0" encoding="UTF-8"?>
<!-- Qubes HUD managed file. Owner: salt/qubes_gui/guest_hud. -->
<style-scheme id="qubes-hud" name="Qubes HUD" version="1.0">
  <author>Qubes HUD</author>
  <description>Cyan syntax on black with bright, persistent selections.</description>

  <color name="black" value="#000000"/>
  <color name="cyan" value="#19d3ff"/>
  <color name="bright" value="#5ff4ff"/>
  <color name="soft" value="#7ae9ff"/>
  <color name="muted" value="#1493b3"/>

  <style name="text" foreground="cyan" background="black"/>
  <style name="selection" foreground="black" background="bright"/>
  <style name="selection-unfocused" use-style="selection"/>
  <style name="cursor" foreground="cyan"/>
  <style name="secondary-cursor" foreground="muted"/>
  <style name="current-line" background="black"/>
  <style name="line-numbers" foreground="muted" background="black"/>
  <style name="current-line-number" foreground="cyan" background="black" bold="true"/>
  <style name="draw-spaces" foreground="muted"/>
  <style name="background-pattern" background="black"/>
  <style name="right-margin" foreground="muted" background="black"/>
  <style name="bracket-match" foreground="bright" bold="true" underline="single"/>
  <style name="bracket-mismatch" foreground="bright" bold="true" underline="double"/>
  <style name="search-match" use-style="selection"/>

  <!-- Standalone scheme: unspecified syntax inherits cyan text, not a stock palette. -->
  <style name="def:comment" foreground="muted" italic="true"/>
  <style name="def:doc-comment-element" foreground="soft" bold="true"/>
  <style name="def:constant" foreground="bright"/>
  <style name="def:string" foreground="soft"/>
  <style name="def:special-char" foreground="bright" bold="true"/>
  <style name="def:special-constant" use-style="def:special-char"/>
  <style name="def:identifier" foreground="cyan"/>
  <style name="def:function" foreground="soft"/>
  <style name="def:statement" foreground="cyan" bold="true"/>
  <style name="def:type" foreground="soft" bold="true"/>
  <style name="def:preprocessor" foreground="bright"/>
  <style name="def:error" foreground="bright" bold="true" underline="error"/>
  <style name="def:warning" foreground="bright" underline="single"/>
  <style name="def:note" foreground="bright" bold="true"/>
  <style name="def:net-address" foreground="soft" underline="single"/>
  <style name="def:underlined" use-style="def:net-address"/>
  <style name="def:emphasis" foreground="cyan" italic="true"/>
  <style name="def:strong-emphasis" use-style="def:statement"/>
  <style name="def:inline-code" foreground="soft"/>
  <style name="def:insertion" foreground="bright" underline="single"/>
  <style name="def:deletion" foreground="muted" strikethrough="true"/>
  <style name="def:link-text" use-style="def:net-address"/>
  <style name="def:link-symbol" foreground="muted"/>
  <style name="def:link-destination" use-style="def:net-address"/>
  <style name="def:heading" foreground="bright" bold="true"/>
  <style name="def:thematic-break" foreground="muted"/>
  <style name="def:preformatted-section" foreground="soft"/>
  <style name="def:list-marker" foreground="bright" bold="true"/>

  <style name="diff:added-line" use-style="def:insertion"/>
  <style name="diff:removed-line" use-style="def:deletion"/>
  <style name="diff:changed-line" use-style="def:constant"/>
  <style name="diff:diff-file" use-style="def:heading"/>
  <style name="diff:location" use-style="def:comment"/>
  <style name="xml:tags" use-style="def:statement"/>
  <style name="xml:attribute-name" use-style="def:identifier"/>
  <style name="xml:namespace" use-style="def:preprocessor"/>
</style-scheme>
