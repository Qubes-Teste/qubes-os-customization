# Qubes HUD managed file. Owner: salt/qubes_gui/guest_hud.

gtk-color-scheme = "hud_bg:#02070c\nhud_surface:#06111a\nhud_raised:#081b29\nhud_cyan:#19d3ff\nhud_cyan_dim:#116b86\nhud_text:#19d3ff\nhud_text_dim:#7bb9c7\nhud_alert:#ff3b6b"
gtk-font-name = "Noto Sans 10"

style "qubes-hud-default" {
  xthickness = 1
  ythickness = 1
  fg[NORMAL] = @hud_text
  fg[PRELIGHT] = @hud_text
  fg[ACTIVE] = @hud_text
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = @hud_text_dim
  bg[NORMAL] = @hud_surface
  bg[PRELIGHT] = @hud_raised
  bg[ACTIVE] = @hud_cyan_dim
  bg[SELECTED] = @hud_cyan_dim
  bg[INSENSITIVE] = @hud_bg
  base[NORMAL] = @hud_bg
  base[ACTIVE] = @hud_surface
  base[SELECTED] = @hud_cyan_dim
  base[INSENSITIVE] = @hud_surface
  text[NORMAL] = @hud_text
  text[ACTIVE] = @hud_text
  text[SELECTED] = "#ffffff"
  text[INSENSITIVE] = @hud_text_dim
}

style "qubes-hud-tooltip" = "qubes-hud-default" {
  bg[NORMAL] = @hud_raised
  fg[NORMAL] = @hud_text
}

class "*" style "qubes-hud-default"
widget "gtk-tooltip*" style "qubes-hud-tooltip"
