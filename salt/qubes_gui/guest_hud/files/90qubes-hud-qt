#!/bin/sh
# Qubes HUD managed file. Owner: salt/qubes_gui/guest_hud.
# Select Qt's GTK integration when a supported adapter is already present.
# This preserves the formula's original generic behavior; the Whonix palette
# is scoped separately through the Sdwdate service and standalone Tor launcher.

for qubes_hud_qgtk in \
  /usr/lib/*/qt5/plugins/platformthemes/libqgtk3.so \
  /usr/lib*/qt5/plugins/platformthemes/libqgtk3.so \
  /usr/lib/*/qt6/plugins/platformthemes/libqgtk3.so \
  /usr/lib*/qt6/plugins/platformthemes/libqgtk3.so
do
  if [ -f "${qubes_hud_qgtk}" ]; then
    QT_QPA_PLATFORMTHEME=gtk3
    export QT_QPA_PLATFORMTHEME
    break
  fi
done

unset qubes_hud_qgtk
