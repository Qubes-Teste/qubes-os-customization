class LauncherError(RuntimeError):
    """A refusal caused by unsafe ownership or inconsistent package state."""


@dataclass(frozen=True)
class PackageSnapshot:
    """The installed version, path list, and hashes declared by dpkg."""

    name: str
    version: str
    md5s: dict[str, str]
    paths: frozenset[str]


def _wrapper_bytes() -> bytes:
    diverted = shlex.quote(str(DIVERTED))
    return (
        "#!/bin/sh\n"
        f"# {OWNER_MARKER}\n"
        "export QT_QPA_PLATFORMTHEME=qt5ct\n"
        "export XDG_CONFIG_HOME=/etc/qubes-hud/xdg\n"
        f'exec {diverted} "$@"\n'
    ).encode("utf-8")


def _digest(path: Path, algorithm: str = "sha256") -> str:
    if algorithm == "md5":
        digest = hashlib.md5(usedforsecurity=False)
    else:
        digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _bytes_sha256(contents: bytes) -> str:
    return hashlib.sha256(contents).hexdigest()


def _run(
    arguments: list[str], *, allowed: tuple[int, ...] = (0,)
) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    try:
        result = subprocess.run(
            arguments,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=environment,
        )
    except FileNotFoundError as error:
        raise LauncherError(f"required command is missing: {arguments[0]}") from error
    if result.returncode not in allowed:
        diagnostic = result.stderr.strip() or result.stdout.strip() or "no diagnostic"
        raise LauncherError(
            f"command failed ({result.returncode}): {' '.join(arguments)}: {diagnostic}"
        )
    return result


def _assert_real_directory(path: Path, mode: int | None = None) -> os.stat_result:
    try:
        path_stat = path.lstat()
    except FileNotFoundError as error:
        raise LauncherError(f"required directory is missing: {path}") from error
    if stat.S_ISLNK(path_stat.st_mode) or not stat.S_ISDIR(path_stat.st_mode):
        raise LauncherError(f"path is not a real directory: {path}")
    if path_stat.st_uid != 0 or path_stat.st_gid != 0:
        raise LauncherError(f"directory is not owned by root:root: {path}")
    if mode is not None and stat.S_IMODE(path_stat.st_mode) != mode:
        raise LauncherError(f"directory mode is not {mode:04o}: {path}")
    if path_stat.st_nlink < 2:
        raise LauncherError(f"directory link count is unsafe: {path}")
    return path_stat


def _assert_regular_file(
    path: Path, *, mode: int, allow_missing: bool = False
) -> os.stat_result | None:
    try:
        path_stat = path.lstat()
    except FileNotFoundError:
        if allow_missing:
            return None
        raise LauncherError(f"required file is missing: {path}") from None
    if stat.S_ISLNK(path_stat.st_mode) or not stat.S_ISREG(path_stat.st_mode):
        raise LauncherError(f"path is not a regular file: {path}")
    if path_stat.st_uid != 0 or path_stat.st_gid != 0:
        raise LauncherError(f"file is not owned by root:root: {path}")
    if stat.S_IMODE(path_stat.st_mode) != mode:
        raise LauncherError(f"file mode is not {mode:04o}: {path}")
    if path_stat.st_nlink != 1:
        raise LauncherError(f"file has unexpected hard links: {path}")
    return path_stat


def _assert_formula_namespace() -> None:
    _assert_real_directory(CONFIG_ROOT, 0o755)
    _assert_regular_file(CONFIG_OWNER, mode=0o644)
    try:
        owner_text = CONFIG_OWNER.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise LauncherError(f"cannot read formula ownership marker: {CONFIG_OWNER}") from error
    if OWNER_MARKER not in owner_text:
        raise LauncherError(f"formula ownership marker is invalid: {CONFIG_OWNER}")


def _assert_launcher_namespace(*, required: bool = True) -> bool:
    """Prove that every parent used for the launcher mutation is real."""
    for ancestor in (Path("/"), Path("/usr"), LIBEXEC_ROOT):
        _assert_real_directory(ancestor)
    try:
        TARGET.parent.lstat()
    except FileNotFoundError:
        if required:
            raise LauncherError(f"required directory is missing: {TARGET.parent}") from None
        return False
    _assert_real_directory(TARGET.parent, 0o755)
    return True


def _dpkg_tools_available(*, required: bool = False) -> bool:
    statuses: list[tuple[Path, os.stat_result | None]] = []
    for tool in (DPKG_QUERY, DPKG_DIVERT):
        try:
            tool_stat = tool.lstat()
        except FileNotFoundError:
            tool_stat = None
        statuses.append((tool, tool_stat))
    present = [tool_stat is not None for _, tool_stat in statuses]
    if not any(present):
        if required:
            raise LauncherError("Debian package tools are unavailable")
        return False
    if not all(present):
        raise LauncherError("Debian package tool installation is incomplete")
    for tool, tool_stat in statuses:
        assert tool_stat is not None
        if stat.S_ISLNK(tool_stat.st_mode) or not stat.S_ISREG(tool_stat.st_mode):
            raise LauncherError(f"package tool is not a regular file: {tool}")
        if tool_stat.st_uid != 0 or tool_stat.st_gid != 0:
            raise LauncherError(f"package tool is not owned by root:root: {tool}")
        if tool_stat.st_nlink != 1 or stat.S_IMODE(tool_stat.st_mode) & 0o022:
            raise LauncherError(f"package tool metadata is unsafe: {tool}")
        if not os.access(tool, os.X_OK):
            raise LauncherError(f"package tool is not executable: {tool}")
    return True


def _package_snapshot(name: str, *, required: bool) -> PackageSnapshot | None:
    if not _dpkg_tools_available(required=required):
        return None
    query = _run(
        [str(DPKG_QUERY), "-W", "-f=${db:Status-Status}\t${Version}\n", name],
        allowed=(0, 1),
    )
    if query.returncode == 1:
        if query.stdout.strip():
            raise LauncherError(f"unexpected dpkg-query output for {name}")
        if required:
            raise LauncherError(f"required package is not installed: {name}")
        return None
    fields = query.stdout.rstrip("\n").split("\t")
    if len(fields) != 2 or fields[0] != "installed" or not fields[1]:
        if required:
            raise LauncherError(f"required package is not installed: {name}")
        return None
    if "\n" in fields[1]:
        raise LauncherError(f"invalid package version for {name}")

    listing = _run([str(DPKG_QUERY), "-L", name])
    package_paths = frozenset(listing.stdout.splitlines())
    control = _run([str(DPKG_QUERY), "--control-path", name, "md5sums"])
    control_name = control.stdout.strip()
    if not control_name or "\n" in control_name:
        raise LauncherError(f"could not resolve {name}'s md5sums file")
    control_path = Path(control_name)
    _assert_regular_file(control_path, mode=0o644)
    try:
        lines = control_path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise LauncherError(f"cannot read package hashes: {control_path}") from error
    md5s: dict[str, str] = {}
    for line in lines:
        parts = line.split(None, 1)
        if len(parts) != 2 or MD5_RE.fullmatch(parts[0]) is None:
            raise LauncherError(f"invalid entry in package hash file: {control_path}")
        relative = parts[1].removeprefix("./")
        if relative in md5s:
            raise LauncherError(f"duplicate entry in package hash file: {relative}")
        md5s[relative] = parts[0]
    return PackageSnapshot(name, fields[1], md5s, package_paths)


def _package_owns_target(snapshot: PackageSnapshot) -> bool:
    relative = str(TARGET).removeprefix("/")
    listed = str(TARGET) in snapshot.paths
    hashed = relative in snapshot.md5s
    if listed != hashed:
        raise LauncherError(f"{PACKAGE} file listing and hashes disagree for {TARGET}")
    return listed


def _require_package_target(snapshot: PackageSnapshot) -> None:
    if not _package_owns_target(snapshot):
        raise LauncherError(
            f"{PACKAGE} no longer provides {TARGET}; run remove to restore "
            "forward-compatible package state"
        )


def _validate_package_target(path: Path, snapshot: PackageSnapshot) -> str:
    _assert_launcher_namespace()
    _require_package_target(snapshot)
    _assert_regular_file(path, mode=0o755)
    expected_md5 = snapshot.md5s[str(TARGET).removeprefix("/")]
    if _digest(path, "md5") != expected_md5:
        raise LauncherError(f"package-owned content hash changed: {path}")
    return _digest(path)


def _assert_path_below(path: Path, root: Path) -> None:
    try:
        path.relative_to(root)
    except ValueError as error:
        raise LauncherError(f"package path escapes expected root: {path}") from error
    current = path.parent
    parents: list[Path] = []
    while current != root:
        parents.append(current)
        current = current.parent
    _assert_real_directory(root)
    for parent in reversed(parents):
        _assert_real_directory(parent)


def _validate_qt5ct_plugin(snapshot: PackageSnapshot) -> None:
    suffix = "/qt5/plugins/platformthemes/libqt5ct.so"
    listed = {
        path
        for path in snapshot.paths
        if path.startswith(str(QT5_PLUGIN_ROOT) + "/") and path.endswith(suffix)
    }
    hashed = {
        "/" + path
        for path in snapshot.md5s
        if ("/" + path).startswith(str(QT5_PLUGIN_ROOT) + "/")
        and ("/" + path).endswith(suffix)
    }
    if listed != hashed:
        raise LauncherError(f"{QT5CT_PACKAGE} plugin listing and hashes disagree")
    if not listed:
        raise LauncherError(f"{QT5CT_PACKAGE} does not provide its Qt 5 platform plugin")
    for plugin_name in sorted(listed):
        plugin = Path(plugin_name)
        _assert_path_below(plugin, QT5_PLUGIN_ROOT)
        _assert_regular_file(plugin, mode=0o644)
        expected_md5 = snapshot.md5s[plugin_name.removeprefix("/")]
        if _digest(plugin, "md5") != expected_md5:
            raise LauncherError(f"package-owned plugin content changed: {plugin}")


def _validate_managed_file(path: Path, expected_sha256: str) -> None:
    _assert_regular_file(path, mode=0o644)
    if _digest(path) != expected_sha256:
        raise LauncherError(f"managed Qt configuration content changed: {path}")
    try:
        contents = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise LauncherError(f"cannot read managed Qt configuration: {path}") from error
    if OWNER_MARKER not in contents:
        raise LauncherError(f"managed Qt configuration marker is invalid: {path}")


def _validate_prerequisites() -> None:
    _assert_formula_namespace()
    _assert_real_directory(CONFIG_ROOT / "xdg", 0o755)
    _assert_real_directory(QT5CT_ROOT, 0o755)
    _assert_real_directory(QT5CT_COLORS_ROOT, 0o755)
    _validate_managed_file(QT5CT_CONFIG, QT5CT_CONFIG_SHA256)
    _validate_managed_file(QT5CT_PALETTE, QT5CT_PALETTE_SHA256)
    qt5ct = _package_snapshot(QT5CT_PACKAGE, required=True)
    assert qt5ct is not None
    _validate_qt5ct_plugin(qt5ct)


def _diversion() -> str:
    _dpkg_tools_available(required=True)
    owner = _run([str(DPKG_DIVERT), "--listpackage", str(TARGET)]).stdout.rstrip("\n")
    true_name = _run([str(DPKG_DIVERT), "--truename", str(TARGET)]).stdout.rstrip("\n")
    if "\n" in owner or "\n" in true_name:
        raise LauncherError(f"ambiguous diversion metadata for {TARGET}")
    if not owner and true_name == str(TARGET):
        return "absent"
    if owner == "LOCAL" and true_name == str(DIVERTED):
        return "managed"
    raise LauncherError(
        f"foreign or unexpected diversion for {TARGET}: "
        f"owner={owner or '<none>'}, target={true_name or '<none>'}"
    )


