def _validate_hash(value: object, field: str) -> str:
    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
        raise LauncherError(f"ownership record has invalid {field}")
    return value


def _validate_record_data(value: object) -> dict[str, object]:
    expected = {
        "schema",
        "owner",
        "manager",
        "phase",
        "wrapper_revision",
        "desired_revision",
        "package",
        "package_version",
        "target",
        "diverted",
        "managed_sha256",
        "desired_sha256",
        "original_sha256",
    }
    if not isinstance(value, dict) or set(value) != expected:
        raise LauncherError("Tor Control Panel ownership record has an invalid schema")
    if (
        type(value["schema"]) is not int
        or value["schema"] != RECORD_SCHEMA
        or value["owner"] != OWNER_MARKER
    ):
        raise LauncherError("Tor Control Panel ownership record is not formula-owned")
    if (
        value["manager"] != MANAGER_NAME
        or value["package"] != PACKAGE
        or value["target"] != str(TARGET)
        or value["diverted"] != str(DIVERTED)
    ):
        raise LauncherError("Tor Control Panel ownership record targets unexpected paths")
    if value["phase"] not in ("installing", "installed", "removing"):
        raise LauncherError("Tor Control Panel ownership record has an invalid phase")
    if type(value["wrapper_revision"]) is not int or value["wrapper_revision"] < 1:
        raise LauncherError("ownership record has an invalid wrapper revision")
    desired_revision = value["desired_revision"]
    if desired_revision is not None and (
        type(desired_revision) is not int or desired_revision < 1
    ):
        raise LauncherError("ownership record has an invalid desired revision")
    if not isinstance(value["package_version"], str) or not value["package_version"]:
        raise LauncherError("ownership record has an invalid package version")
    if "\n" in value["package_version"]:
        raise LauncherError("ownership record has an invalid package version")
    _validate_hash(value["managed_sha256"], "managed hash")
    _validate_hash(value["original_sha256"], "original hash")
    desired_sha = value["desired_sha256"]
    if desired_sha is not None:
        _validate_hash(desired_sha, "desired hash")
    if (desired_revision is None) != (desired_sha is None):
        raise LauncherError("ownership record has incomplete desired-wrapper fields")
    if value["phase"] == "installed" and desired_revision is not None:
        raise LauncherError("installed ownership record cannot have a pending wrapper")
    if value["phase"] == "installing" and desired_revision is None:
        raise LauncherError("installing ownership record lacks a pending wrapper")
    return value


def _load_record() -> dict[str, object] | None:
    try:
        record_stat = RECORD.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(record_stat.st_mode) or not stat.S_ISREG(record_stat.st_mode):
        raise LauncherError(f"ownership record is not a regular file: {RECORD}")
    if (
        stat.S_IMODE(record_stat.st_mode) != 0o644
        or record_stat.st_uid != 0
        or record_stat.st_gid != 0
        or record_stat.st_nlink != 1
    ):
        raise LauncherError(f"ownership record metadata changed: {RECORD}")
    try:
        data = json.loads(RECORD.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise LauncherError(f"cannot parse ownership record: {RECORD}") from error
    return _validate_record_data(data)


def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _write_record(
    data: dict[str, object], *, launcher_namespace_required: bool = True
) -> None:
    _validate_record_data(data)
    _assert_formula_namespace()
    _assert_launcher_namespace(required=launcher_namespace_required)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{RECORD.name}.", dir=CONFIG_ROOT)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.chown(temporary, 0, 0)
        os.replace(temporary, RECORD)
        _fsync_directory(CONFIG_ROOT)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _remove_record() -> None:
    try:
        RECORD.unlink()
    except FileNotFoundError:
        return
    _fsync_directory(CONFIG_ROOT)


def _atomic_move(source: Path, destination: Path) -> None:
    _assert_launcher_namespace()
    if destination.exists() or destination.is_symlink():
        raise LauncherError(f"refusing to replace existing recovery target: {destination}")
    os.replace(source, destination)
    _fsync_directory(TARGET.parent)


def _atomic_wrapper_write(contents: bytes) -> None:
    _assert_launcher_namespace()
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{TARGET.name}.qubes-hud.", dir=TARGET.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o755)
        os.chown(temporary, 0, 0)
        os.replace(temporary, TARGET)
        _fsync_directory(TARGET.parent)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _wrapper_hash(accepted: set[str], *, allow_missing: bool = False) -> str | None:
    _assert_launcher_namespace()
    target_stat = _assert_regular_file(TARGET, mode=0o755, allow_missing=allow_missing)
    if target_stat is None:
        return None
    actual = _digest(TARGET)
    if actual not in accepted:
        raise LauncherError(f"managed Tor Control Panel wrapper changed: {TARGET}")
    return actual


def _original_hash(
    snapshot: PackageSnapshot | None,
    recorded_sha256: str,
    *,
    allow_missing_without_package: bool,
) -> str | None:
    _assert_launcher_namespace()
    if snapshot is not None and _package_owns_target(snapshot):
        return _validate_package_target(DIVERTED, snapshot)
    original_stat = _assert_regular_file(
        DIVERTED, mode=0o755, allow_missing=allow_missing_without_package
    )
    if original_stat is None:
        return None
    actual = _digest(DIVERTED)
    if actual != recorded_sha256:
        raise LauncherError(f"diverted package launcher changed: {DIVERTED}")
    return actual


def _new_record(
    snapshot: PackageSnapshot, original_sha256: str, desired_sha256: str
) -> dict[str, object]:
    return {
        "schema": RECORD_SCHEMA,
        "owner": OWNER_MARKER,
        "manager": MANAGER_NAME,
        "phase": "installing",
        "wrapper_revision": WRAPPER_REVISION,
        "desired_revision": WRAPPER_REVISION,
        "package": PACKAGE,
        "package_version": snapshot.version,
        "target": str(TARGET),
        "diverted": str(DIVERTED),
        "managed_sha256": desired_sha256,
        "desired_sha256": desired_sha256,
        "original_sha256": original_sha256,
    }


def _accepted_wrapper_hashes(record: dict[str, object]) -> set[str]:
    accepted = {record["managed_sha256"]}
    if record["desired_sha256"] is not None:
        accepted.add(record["desired_sha256"])
    return accepted


def _preflight_unmanaged(snapshot: PackageSnapshot | None) -> None:
    namespace_present = _assert_launcher_namespace(
        required=snapshot is not None and _package_owns_target(snapshot)
    )
    has_dpkg = _dpkg_tools_available()
    if has_dpkg and _diversion() != "absent":
        raise LauncherError(f"unowned diversion already exists for {TARGET}")
    if namespace_present and (DIVERTED.exists() or DIVERTED.is_symlink()):
        raise LauncherError(f"unowned diversion backup already exists: {DIVERTED}")
    package_owns = snapshot is not None and _package_owns_target(snapshot)
    if not namespace_present:
        return
    if package_owns:
        _validate_package_target(TARGET, snapshot)
    elif TARGET.exists() or TARGET.is_symlink():
        raise LauncherError(f"unowned Tor Control Panel launcher remains: {TARGET}")


def _validate_installed(
    record: dict[str, object], snapshot: PackageSnapshot
) -> tuple[bool, str | None]:
    _assert_launcher_namespace()
    if record["phase"] != "installed":
        raise LauncherError("ownership record is not in the installed phase")
    if _diversion() != "managed":
        raise LauncherError(f"managed diversion disappeared: {TARGET}")
    original = _original_hash(
        snapshot,
        record["original_sha256"],
        allow_missing_without_package=not _package_owns_target(snapshot),
    )
    _wrapper_hash({record["managed_sha256"]})
    desired_sha256 = _bytes_sha256(_wrapper_bytes())
    fresh = (
        _package_owns_target(snapshot)
        and original is not None
        and record["wrapper_revision"] == WRAPPER_REVISION
        and record["package_version"] == snapshot.version
        and record["managed_sha256"] == desired_sha256
        and record["original_sha256"] == original
    )
    if fresh:
        _validate_prerequisites()
    return fresh, original


def _validate_installing(
    record: dict[str, object], snapshot: PackageSnapshot, desired_sha256: str
) -> None:
    _assert_launcher_namespace()
    _require_package_target(snapshot)
    if record["phase"] != "installing":
        raise LauncherError("ownership record is not in the installing phase")
    if record["desired_revision"] != WRAPPER_REVISION:
        raise LauncherError("interrupted install expects a different wrapper revision")
    if record["desired_sha256"] != desired_sha256:
        raise LauncherError("interrupted install expects different wrapper content")
    diversion = _diversion()
    if diversion == "absent":
        if DIVERTED.exists() or DIVERTED.is_symlink():
            _original_hash(
                snapshot,
                record["original_sha256"],
                allow_missing_without_package=False,
            )
            if TARGET.exists() or TARGET.is_symlink():
                raise LauncherError(f"both paths exist during interrupted diversion add: {TARGET}")
        else:
            _validate_package_target(TARGET, snapshot)
    elif DIVERTED.exists() or DIVERTED.is_symlink():
        _original_hash(
            snapshot,
            record["original_sha256"],
            allow_missing_without_package=False,
        )
        _wrapper_hash(_accepted_wrapper_hashes(record), allow_missing=True)
    else:
        # dpkg-divert records ADD metadata before renaming the package file.
        _validate_package_target(TARGET, snapshot)


def _validate_removing(
    record: dict[str, object], snapshot: PackageSnapshot | None
) -> None:
    namespace_present = _assert_launcher_namespace(
        required=snapshot is not None and _package_owns_target(snapshot)
    )
    if record["phase"] not in ("installing", "installed", "removing"):
        raise LauncherError("ownership record cannot be removed safely")
    diversion = _diversion()
    if not namespace_present:
        return
    accepted = _accepted_wrapper_hashes(record)
    package_owns = snapshot is not None and _package_owns_target(snapshot)
    if diversion == "managed":
        if DIVERTED.exists() or DIVERTED.is_symlink():
            _original_hash(
                snapshot,
                record["original_sha256"],
                allow_missing_without_package=True,
            )
            _wrapper_hash(accepted, allow_missing=True)
        elif package_owns:
            # dpkg-divert renamed REMOVE's backup before committing metadata.
            _validate_package_target(TARGET, snapshot)
        elif TARGET.exists() or TARGET.is_symlink():
            _assert_regular_file(TARGET, mode=0o755)
            actual = _digest(TARGET)
            if actual not in accepted | {record["original_sha256"]}:
                raise LauncherError(f"unexpected removal-recovery content: {TARGET}")
        return
    if DIVERTED.exists() or DIVERTED.is_symlink():
        _original_hash(
            snapshot,
            record["original_sha256"],
            allow_missing_without_package=True,
        )
        if TARGET.exists() or TARGET.is_symlink():
            raise LauncherError(f"both paths exist after interrupted diversion removal: {TARGET}")
        return
    if package_owns:
        _validate_package_target(TARGET, snapshot)
    elif TARGET.exists() or TARGET.is_symlink():
        _assert_regular_file(TARGET, mode=0o755)
        if _digest(TARGET) != record["original_sha256"]:
            raise LauncherError(f"unowned launcher remains after diversion removal: {TARGET}")


def _prepare_update(
    record: dict[str, object],
    snapshot: PackageSnapshot,
    original_sha256: str | None,
    desired_sha256: str,
) -> dict[str, object]:
    if original_sha256 is None:
        raise LauncherError("cannot update without the package launcher")
    pending = json.loads(json.dumps(record))
    pending["phase"] = "installing"
    pending["desired_revision"] = WRAPPER_REVISION
    pending["desired_sha256"] = desired_sha256
    pending["package_version"] = snapshot.version
    pending["original_sha256"] = original_sha256
    return _validate_record_data(pending)


def _finish_record(
    record: dict[str, object], snapshot: PackageSnapshot, original_sha256: str
) -> dict[str, object]:
    completed = json.loads(json.dumps(record))
    completed["phase"] = "installed"
    completed["wrapper_revision"] = completed["desired_revision"]
    completed["desired_revision"] = None
    completed["managed_sha256"] = completed["desired_sha256"]
    completed["desired_sha256"] = None
    completed["package_version"] = snapshot.version
    completed["original_sha256"] = original_sha256
    return _validate_record_data(completed)


def _resume_install(
    record: dict[str, object], snapshot: PackageSnapshot, wrapper: bytes
) -> None:
    _assert_launcher_namespace()
    _validate_prerequisites()
    desired_sha256 = _bytes_sha256(wrapper)
    _validate_installing(record, snapshot, desired_sha256)
    diversion = _diversion()
    if diversion == "absent":
        if DIVERTED.exists() or DIVERTED.is_symlink():
            _original_hash(
                snapshot,
                record["original_sha256"],
                allow_missing_without_package=False,
            )
            if TARGET.exists() or TARGET.is_symlink():
                raise LauncherError(f"both paths exist during interrupted diversion add: {TARGET}")
            _add_diversion_metadata()
        else:
            _validate_package_target(TARGET, snapshot)
            _add_diversion()
        if _diversion() != "managed":
            raise LauncherError(f"dpkg did not install diversion for {TARGET}")
    if not DIVERTED.exists() and not DIVERTED.is_symlink():
        # Recover ADD after its database commit but before its file rename.
        _validate_package_target(TARGET, snapshot)
        _atomic_move(TARGET, DIVERTED)
    _original_hash(
        snapshot,
        record["original_sha256"],
        allow_missing_without_package=False,
    )
    actual = _wrapper_hash(_accepted_wrapper_hashes(record), allow_missing=True)
    if actual != desired_sha256:
        _atomic_wrapper_write(wrapper)
    _wrapper_hash({desired_sha256})

    final_snapshot = _package_snapshot(PACKAGE, required=True)
    assert final_snapshot is not None
    _require_package_target(final_snapshot)
    _validate_prerequisites()
    if _diversion() != "managed":
        raise LauncherError(f"managed diversion disappeared: {TARGET}")
    original_sha256 = _validate_package_target(DIVERTED, final_snapshot)
    _wrapper_hash({desired_sha256})
    _write_record(_finish_record(record, final_snapshot, original_sha256))


def install() -> None:
    wrapper = _wrapper_bytes()
    desired_sha256 = _bytes_sha256(wrapper)
    snapshot = _package_snapshot(PACKAGE, required=False)
    record = _load_record()
    if record is not None:
        _assert_launcher_namespace(
            required=snapshot is not None and _package_owns_target(snapshot)
        )
    if snapshot is None and record is None:
        _preflight_unmanaged(None)
        return
    if snapshot is None:
        raise LauncherError(f"{PACKAGE} was removed with a managed diversion; run remove")
    package_owns = _package_owns_target(snapshot)
    if record is None:
        _preflight_unmanaged(snapshot)
        if not package_owns:
            return
        _validate_prerequisites()
        original_sha256 = _validate_package_target(TARGET, snapshot)
        record = _new_record(snapshot, original_sha256, desired_sha256)
        _write_record(record)
    else:
        _require_package_target(snapshot)
        _validate_prerequisites()
    if record["phase"] == "removing":
        raise LauncherError("Tor Control Panel launcher rollback is in progress; run remove")
    if record["phase"] == "installed":
        fresh, original_sha256 = _validate_installed(record, snapshot)
        if fresh:
            return
        record = _prepare_update(record, snapshot, original_sha256, desired_sha256)
        _write_record(record)
    else:
        _validate_installing(record, snapshot, desired_sha256)
    _resume_install(record, snapshot, wrapper)


def check() -> bool:
    snapshot = _package_snapshot(PACKAGE, required=False)
    record = _load_record()
    if record is not None:
        _assert_launcher_namespace(
            required=snapshot is not None and _package_owns_target(snapshot)
        )
    if record is None:
        _preflight_unmanaged(snapshot)
        return snapshot is None or not _package_owns_target(snapshot)
    if snapshot is None:
        _validate_removing(record, None)
        return False
    if record["phase"] == "installed":
        fresh, _ = _validate_installed(record, snapshot)
        return fresh
    if record["phase"] == "installing":
        _validate_prerequisites()
        _validate_installing(record, snapshot, _bytes_sha256(_wrapper_bytes()))
        return False
    _validate_removing(record, snapshot)
    return False


def validate_removal() -> None:
    snapshot = _package_snapshot(PACKAGE, required=False)
    record = _load_record()
    if record is None:
        _preflight_unmanaged(snapshot)
        return
    _validate_removing(record, snapshot)


def _unlink_wrapper(accepted: set[str]) -> None:
    _assert_launcher_namespace()
    actual = _wrapper_hash(accepted, allow_missing=True)
    if actual is None:
        return
    TARGET.unlink()
    _fsync_directory(TARGET.parent)


def _resume_remove(
    record: dict[str, object], snapshot: PackageSnapshot | None
) -> None:
    namespace_present = _assert_launcher_namespace(
        required=snapshot is not None and _package_owns_target(snapshot)
    )
    _validate_removing(record, snapshot)
    diversion = _diversion()
    if not namespace_present:
        if diversion == "managed":
            _remove_diversion_metadata()
            if _diversion() != "absent":
                raise LauncherError(f"dpkg did not remove diversion metadata for {TARGET}")
        _remove_record()
        return

    accepted = _accepted_wrapper_hashes(record)
    package_owns = snapshot is not None and _package_owns_target(snapshot)
    backup_present = DIVERTED.exists() or DIVERTED.is_symlink()
    if diversion == "managed" and backup_present:
        _original_hash(
            snapshot,
            record["original_sha256"],
            allow_missing_without_package=True,
        )
        _unlink_wrapper(accepted)
        _remove_diversion()
        if _diversion() != "absent":
            raise LauncherError(f"dpkg did not remove diversion for {TARGET}")
        if DIVERTED.exists() or DIVERTED.is_symlink():
            raise LauncherError(f"diversion backup remains after removal: {DIVERTED}")
    elif diversion == "managed":
        # Recover REMOVE after its rename but before its database commit.
        if TARGET.exists() or TARGET.is_symlink():
            _assert_regular_file(TARGET, mode=0o755)
            actual = _digest(TARGET)
            if package_owns:
                _validate_package_target(TARGET, snapshot)
            elif actual in accepted:
                _unlink_wrapper(accepted)
            elif actual != record["original_sha256"]:
                raise LauncherError(f"unexpected removal-recovery content: {TARGET}")
        elif package_owns:
            raise LauncherError(f"package launcher is missing during recovery: {TARGET}")
        _remove_diversion_metadata()
        if _diversion() != "absent":
            raise LauncherError(f"dpkg did not remove diversion metadata for {TARGET}")
    elif backup_present:
        # Recover inverse ordering if metadata disappeared before the rename.
        _original_hash(
            snapshot,
            record["original_sha256"],
            allow_missing_without_package=True,
        )
        if TARGET.exists() or TARGET.is_symlink():
            raise LauncherError(f"both paths exist after interrupted diversion removal: {TARGET}")
        _atomic_move(DIVERTED, TARGET)

    if package_owns:
        _validate_package_target(TARGET, snapshot)
    elif TARGET.exists() or TARGET.is_symlink():
        _assert_regular_file(TARGET, mode=0o755)
        if _digest(TARGET) != record["original_sha256"]:
            raise LauncherError(f"unexpected launcher remains after rollback: {TARGET}")
        TARGET.unlink()
        _fsync_directory(TARGET.parent)
    if DIVERTED.exists() or DIVERTED.is_symlink():
        raise LauncherError(f"diversion backup remains after recovery: {DIVERTED}")
    _remove_record()


def remove() -> None:
    snapshot = _package_snapshot(PACKAGE, required=False)
    record = _load_record()
    if record is None:
        _preflight_unmanaged(snapshot)
        return
    _validate_removing(record, snapshot)
    if record["phase"] != "removing":
        removing = json.loads(json.dumps(record))
        removing["phase"] = "removing"
        _write_record(
            _validate_record_data(removing),
            launcher_namespace_required=(
                snapshot is not None and _package_owns_target(snapshot)
            ),
        )
        record = removing
    _resume_remove(record, snapshot)


def _lock() -> int:
    _assert_real_directory(LOCK.parent)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(LOCK, flags, 0o600)
    lock_stat = os.fstat(descriptor)
    if (
        not stat.S_ISREG(lock_stat.st_mode)
        or lock_stat.st_uid != 0
        or lock_stat.st_gid != 0
        or stat.S_IMODE(lock_stat.st_mode) != 0o600
        or lock_stat.st_nlink != 1
    ):
        os.close(descriptor)
        raise LauncherError(f"unsafe manager lock file: {LOCK}")
    fcntl.flock(descriptor, fcntl.LOCK_EX)
    return descriptor


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action", choices=("install", "check", "validate-removal", "remove")
    )
    return parser.parse_args()


def main() -> int:
    arguments = _arguments()
    lock_descriptor = -1
    try:
        if os.geteuid() != 0:
            raise LauncherError("Tor Control Panel launcher management must run as root")
        _assert_formula_namespace()
        lock_descriptor = _lock()
        if arguments.action == "install":
            install()
            print("Tor Control Panel HUD launcher is installed (or package is absent)")
            return 0
        if arguments.action == "check":
            return 0 if check() else 1
        if arguments.action == "validate-removal":
            validate_removal()
            return 0
        remove()
        print("Tor Control Panel HUD launcher is removed")
        return 0
    except (LauncherError, OSError) as error:
        print(f"Qubes HUD Tor Control Panel launcher refused: {error}", file=sys.stderr)
        return 2
    finally:
        if lock_descriptor >= 0:
            os.close(lock_descriptor)


if __name__ == "__main__":
    raise SystemExit(main())
