{
  "name": "Qubes HUD",
  "type": "hc",
  "colors": {
    "foreground": "#19d3ff",
    "descriptionForeground": "#1493b3",
    "focusBorder": "#19d3ff",
    "contrastBorder": "#1493b3",
    "contrastActiveBorder": "#19d3ff",
    "selection.background": "#5ff4ff",
    "textLink.foreground": "#7ae9ff",
    "icon.foreground": "#19d3ff",
    "editor.background": "#000000",
    "editor.foreground": "#19d3ff",
    "editorCursor.foreground": "#5ff4ff",
    "editor.selectionBackground": "#5ff4ff",
    "editor.selectionForeground": "#000000",
    "editor.inactiveSelectionBackground": "#5ff4ff80",
    "editorLineNumber.foreground": "#1493b3",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorWidget.background": "#000000",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#19d3ff",
    "sideBarSectionHeader.background": "#000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#19d3ff",
    "panel.background": "#000000",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#19d3ff",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#5ff4ff",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#1493b3",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#19d3ff",
    "titleBar.inactiveBackground": "#000000",
    "button.background": "#19d3ff",
    "button.foreground": "#000000",
    "button.hoverBackground": "#5ff4ff",
    "input.background": "#000000",
    "input.foreground": "#19d3ff",
    "input.border": "#1493b3",
    "dropdown.background": "#000000",
    "dropdown.foreground": "#19d3ff",
    "list.activeSelectionBackground": "#5ff4ff",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#5ff4ff",
    "list.inactiveSelectionForeground": "#000000",
    "notifications.background": "#000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#19d3ff",
    "terminal.selectionBackground": "#5ff4ff",
    "terminal.selectionForeground": "#000000",
    "terminalCursor.foreground": "#5ff4ff"
  },
  "tokenColors": [
    {"settings": {"foreground": "#19d3ff"}},
    {"scope": "comment", "settings": {"foreground": "#1493b3"}},
    {"scope": "keyword, storage", "settings": {"foreground": "#5ff4ff"}},
    {"scope": "constant, entity.name.function", "settings": {"foreground": "#7ae9ff"}},
    {"scope": "invalid", "settings": {"foreground": "#ff3b6b"}}
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "*": "#19d3ff",
    "comment": "#1493b3",
    "keyword": "#5ff4ff"
  }
}
