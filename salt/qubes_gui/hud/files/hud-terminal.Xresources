! Qubes HUD managed file. Owner: salt/qubes_gui/hud.
! Scoped to dedicated HUD terminals through XENVIRONMENT.
*VT100.translations: #replace\n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD)\n\
    Ctrl <Key>Insert: copy-selection(CLIPBOARD)\n\
    Shift <Key>Prior: scroll-back(1,halfpage)\n\
    Shift <Key>Next: scroll-forw(1,halfpage)\n\
    <Key>: ignore()\n\
    <Btn1Down>: select-start()\n\
    <Btn1Motion>: select-extend()\n\
    <Btn1Up>: select-end(PRIMARY)\n\
    <Btn4Down>: scroll-back(3,line)\n\
    <Btn5Down>: scroll-forw(3,line)
*VT100.allowMouseOps: false
*VT100.allowSendEvents: false
*VT100.allowWindowOps: false
*VT100.allowTitleOps: false
*VT100.allowFontOps: false
*VT100.allowColorOps: false
*VT100.allowTcapOps: false
*VT100.saveLines: 600
*VT100.disallowedWindowOps: *
*VT100.disallowedColorOps: *
*VT100.disallowedFontOps: *
*VT100.disallowedTcapOps: *
*VT100.scrollBar: false
*VT100.faceName: Noto Sans Mono
*VT100.faceSize: 8
*VT100.foreground: #19d3ff
*VT100.background: #000000
*VT100.renderFont: true

! Keep native ANSI output within the HUD's cyan/black palette.
*VT100.colorMode: false
*VT100.boldColors: false
*VT100.scrollTtyOutput: false
*VT100.scrollKey: false
