#!/usr/bin/python3
# Qubes HUD managed file. Owner: salt/qubes_gui/hud.
"""Schedule a green display-output matrix using the installed XRandR library."""
import argparse
import configparser
from datetime import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

from hud_output import Outputs

MARKER = '# Qubes HUD managed file. Owner: salt/qubes_gui/hud.'
DEFAULTS = {'mode': 'auto', 'start': '21:00', 'end': '08:00'}
CONFIG = Path.home() / '.config/qubes-hud/night-light.ini'
TIMER = 'qubes-hud-night-light.timer'
SERVICE = 'qubes-hud-night-light.service'
RESTORE = 'qubes-hud-night-light-restore.service'


def minute(value):
    if not isinstance(value, str) or not re.fullmatch(r'(?:[01][0-9]|2[0-3]):[0-5][0-9]', value):
        raise ValueError('Times must use HH:MM, from 00:00 to 23:59')
    return int(value[:2]) * 60 + int(value[3:])


def phase(settings, now=None):
    start, end = minute(settings['start']), minute(settings['end'])
    if start == end or settings['mode'] not in ('auto', 'day', 'night'):
        raise ValueError('Choose different start/end times and mode auto, day or night')
    if settings['mode'] != 'auto':
        return settings['mode']
    now = now or datetime.now()
    current = now.hour * 60 + now.minute
    night = start <= current < end if start < end else current >= start or current < end
    return 'night' if night else 'day'


def words(value):
    if (not isinstance(value, list) or len(value) != 18
            or any(type(n) is not int or not 0 <= n <= 0xffffffff for n in value)):
        raise ValueError('Expected an 18-word XRandR color matrix')
    return value


def green_matrix(base):
    """Compose green-only luminance with the original S31.32 color matrix."""
    values = [lo | hi << 32 for lo, hi in zip(words(base)[::2], base[1::2])]
    signed = [-(n & ((1 << 63) - 1)) if n >> 63 else n for n in values]
    weights = (913110047, 3071760610, 310096639)  # Rec.709, sum exactly 2**32.
    matrix = [0] * 9
    for column in range(3):
        total = sum(weights[row] * signed[row * 3 + column] for row in range(3))
        magnitude = (abs(total) + (1 << 31)) >> 32
        if magnitude >= 1 << 63:
            raise ValueError('Composed color matrix is outside the XRandR range')
        matrix[3 + column] = magnitude | (1 << 63 if total < 0 else 0)
    return [part for n in matrix for part in (n & 0xffffffff, n >> 32)]


def directory(path):
    for parent in (path, *path.parents):
        if stat.S_ISLNK(parent.lstat().st_mode):
            raise ValueError('Refusing a symlink in the settings/runtime path')
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError('A private, owned settings/runtime directory is required')


def read_owned(path, mode, limit=65536):
    directory(path.parent)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != mode):
            raise ValueError('Unexpected owner, mode or file type: ' + str(path))
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise ValueError('Settings/runtime file is too large')
    return data.decode('utf-8')


def write_owned(path, text, mode):
    read_owned(path, mode)  # Validate any existing target before replacing it.
    fd, temporary = tempfile.mkstemp(prefix='.night-light-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def settings():
    raw = read_owned(CONFIG, 0o644, 4096)
    if raw is None or MARKER not in raw.splitlines():
        raise ValueError('The Salt-managed night-light settings file is missing')
    parser = configparser.ConfigParser(interpolation=None)
    parser.read_string(raw)
    if parser.sections() != ['night-light'] or set(parser['night-light']) != set(DEFAULTS):
        raise ValueError('Expected only mode, start and end in [night-light]')
    result = dict(parser['night-light'])
    phase(result)
    return result


def save_settings(value):
    phase(value)
    write_owned(CONFIG, MARKER + '\n[night-light]\n' +
                ''.join(key + ' = ' + value[key] + '\n' for key in DEFAULTS), 0o644)


def transition(output, state, night, save):
    rows = output.snapshot()
    records = state.setdefault('outputs', {})
    unrestored = []
    unsupported = [row['name'] for row in rows if row['ctm'] is None]
    if night and unsupported:
        raise RuntimeError('No output color matrix on: ' + ', '.join(unsupported))
    if night:
        targets = []
        for row in rows:
            current = words(row['ctm'])
            previous = records.get(row['name'])
            owned = previous and previous['identity'] == row['identity'] and current == previous['night']
            base = previous['base'] if owned else current
            target = green_matrix(base)
            records[row['name']] = {'identity': row['identity'], 'base': list(base), 'night': target}
            targets.append((row, target))
        if len(records) > 64:
            raise ValueError('Too many saved display outputs')
        save(state)  # Record original matrices before changing the display.
        for row, target in targets:
            # Xorg can cache the property even after an unsuccessful DRM write.
            output.set(row['id'], target)
    else:
        for row in rows:
            previous = records.get(row['name'])
            if previous:
                if row['identity'] == previous['identity'] and row['ctm'] is None:
                    unrestored.append(row['name'])
                    continue
                if row['identity'] == previous['identity'] and row['ctm'] in (previous['night'], previous['base']):
                    output.set(row['id'], previous['base'])
                else:
                    del records[row['name']]
    state['phase'] = 'night' if night else 'day'
    save(state)
    if unrestored:
        raise RuntimeError('Cannot restore output matrix yet: ' + ', '.join(unrestored))
    return rows


def run(*arguments):
    return subprocess.run(arguments, check=True, timeout=20, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, text=True).stdout


def stop():
    for unit in (TIMER, SERVICE):
        if run('/usr/bin/systemctl', '--user', 'show', unit, '-p', 'LoadState', '--value').strip() != 'not-found':
            run('/usr/bin/systemctl', '--user', 'stop', unit)
    environment = dict(line.split('=', 1) for line in
                       run('/usr/bin/systemctl', '--user', 'show-environment').splitlines() if '=' in line)
    display = environment.get('DISPLAY', '')
    if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', display):
        return  # The HUD has not started a graphical schedule in this manager.
    if run('/usr/bin/systemctl', '--user', 'show', RESTORE, '-p', 'LoadState', '--value').strip() != 'not-found':
        run('/usr/bin/systemctl', '--user', 'start', RESTORE)
    else:
        os.environ['DISPLAY'] = display
        if 'XAUTHORITY' in environment:
            os.environ['XAUTHORITY'] = environment['XAUTHORITY']
        control(restore=True)


def control(restore=False, status=False):
    display = os.environ.get('DISPLAY', '')
    if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', display):
        raise ValueError('A local X11 DISPLAY is required')
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    directory(runtime)
    server, _, screen = display[1:].partition('.')
    stem = 'qubes-hud-night-light-' + server + '-' + (screen or '0')
    path = runtime / (stem + '.json')
    lock = os.open(runtime / (stem + '.lock'), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(lock)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
            raise ValueError('Unexpected night-light lock')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        raw = read_owned(path, 0o600)
        state = json.loads(raw) if raw else {'schema': 1, 'outputs': {}}
        if (not isinstance(state, dict) or state.get('schema') != 1
                or not isinstance(state.get('outputs'), dict) or len(state['outputs']) > 64):
            raise ValueError('Unexpected night-light runtime state')
        for name, record in state['outputs'].items():
            if (not re.fullmatch(r'[A-Za-z0-9_.-]{1,256}', name) or not isinstance(record, dict)
                    or set(record) != {'identity', 'base', 'night'}
                    or not isinstance(record['identity'], str)
                    or not re.fullmatch(re.escape(name) + r':(?:[0-9a-f]{64}|no-edid)', record['identity'])):
                raise ValueError('Unexpected saved output')
            words(record['base']); words(record['night'])
        chosen = DEFAULTS if restore else settings()
        wanted = 'day' if restore else phase(chosen)
        if restore and not state['outputs']:
            return

        def save(value):
            encoded = json.dumps(value, sort_keys=True) + '\n'
            if read_owned(path, 0o600) != encoded:
                write_owned(path, encoded, 0o600)

        with Outputs(display) as output:
            if status:
                rows = output.snapshot()
                print(json.dumps({'schedule': chosen, 'desired': wanted, 'outputs': [
                    {'name': row['name'], 'supported': row['ctm'] is not None,
                     'green_matrix': row['name'] in state['outputs'] and
                        row['ctm'] == state['outputs'][row['name']]['night']} for row in rows]}, indent=2))
            else:
                transition(output, state, wanted == 'night', save)
    finally:
        os.close(lock)


def menu():
    value = settings()
    options = f'Automatic ({value["start"]}–{value["end"]})\nDay — normal colors\nNight — green display\nChange hours\n'
    answer = subprocess.run(['/usr/bin/rofi', '-dmenu', '-p', 'Night Light', '-format', 'i'],
                            input=options, text=True, stdout=subprocess.PIPE, check=False)
    if answer.returncode or answer.stdout.strip() not in ('0', '1', '2', '3'):
        return
    index = int(answer.stdout)
    if index < 3:
        value['mode'] = ('auto', 'day', 'night')[index]
    else:
        answer = subprocess.run(['/usr/bin/rofi', '-dmenu', '-p', 'Night hours: HH:MM HH:MM',
                                 '-filter', value['start'] + ' ' + value['end']],
                                input='', text=True, stdout=subprocess.PIPE, check=False)
        if answer.returncode:
            return
        parts = answer.stdout.split()
        if len(parts) != 2:
            raise ValueError('Enter two times, for example 21:00 08:00')
        value.update(start=parts[0], end=parts[1], mode='auto')
    save_settings(value)
    control()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group()
    for name in ('apply', 'restore', 'status', 'start', 'stop', 'menu', 'check'):
        action.add_argument('--' + name, action='store_true')
    action.add_argument('--mode', choices=('auto', 'day', 'night'))
    action.add_argument('--hours', nargs=2, metavar=('START', 'END'))
    args = parser.parse_args()
    if args.check:
        Outputs(check_only=True)
        print('Night-light XRandR symbols and schedule logic available')
        return
    if os.geteuid() == 0:
        raise ValueError('Run night light as the desktop user, never as root')
    if args.start:
        if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', os.environ.get('DISPLAY', '')):
            raise ValueError('A local X11 DISPLAY is required')
        names = [name for name in ('DISPLAY', 'XAUTHORITY') if name in os.environ]
        if names:
            run('/usr/bin/systemctl', '--user', 'import-environment', *names)
        run('/usr/bin/systemctl', '--user', 'daemon-reload')
        run('/usr/bin/systemctl', '--user', 'start', TIMER, SERVICE)
    elif args.stop:
        stop()
    elif args.menu:
        menu()
    else:
        if args.mode or args.hours:
            value = settings()
            if args.mode:
                value['mode'] = args.mode
            if args.hours:
                value.update(start=args.hours[0], end=args.hours[1], mode='auto')
            save_settings(value)
        control(restore=args.restore, status=args.status)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, configparser.Error, subprocess.SubprocessError) as error:
        print('HUD Night Light: ' + str(error), file=sys.stderr)
        if '--menu' in sys.argv:
            subprocess.run(['/usr/bin/rofi', '-e', str(error)], check=False)
        sys.exit(1)
