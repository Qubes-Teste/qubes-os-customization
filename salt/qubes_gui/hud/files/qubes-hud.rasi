/* Qubes HUD managed file. Owner: salt/qubes_gui/hud. */
configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "APPS";
    display-run:                "CMD";
    display-window:             "WIN";
    drun-display-format:        "{name}";
    disable-history:            false;
    click-to-exit:              true;
}

* {
    hud-root:                   #000000;
    hud-bg:                     #030b12;
    hud-surface:                #06111a;
    hud-surface-raised:         #081b29;
    hud-glass:                  #030b12f0;
    hud-glass-raised:           #071b29e8;
    hud-glass-deep:             #000000f7;
    hud-sheen:                  #d9faff24;
    hud-cyan-wash:              #19d3ff33;
    hud-cyan:                   #19d3ff;
    hud-cyan-muted:             #116b86;
    hud-text:                   #19d3ff;
    hud-text-muted:             #7bb9c7;
    hud-alert:                  #ff3b6b;

    background-color:           transparent;
    text-color:                 @hud-text;
    font:                       "Noto Sans Mono 10";
    border-radius:              0px;
}

window {
    location:                   center;
    anchor:                     center;
    width:                      720px;
    transparency:               "real";
    background-color:           @hud-glass;
    background-image:           linear-gradient(to bottom, #d9faff24, #071b29ee, #030b12f0, #000000f7);
    border:                     2px;
    border-color:               @hud-cyan;
    border-radius:              0px;
    padding:                    3px;
}

mainbox {
    background-color:           #00000052;
    border:                     0px;
    padding:                    12px;
    spacing:                    10px;
    children:                   [ inputbar, message, listview ];
}

inputbar {
    background-color:           @hud-glass-raised;
    background-image:           linear-gradient(to bottom, #d9faff1f, #071b29e8, #030b12e8);
    border:                     0px 0px 1px 0px;
    border-color:               @hud-cyan;
    padding:                    10px 12px;
    spacing:                    10px;
    children:                   [ prompt, entry, case-indicator ];
}

prompt {
    background-color:           @hud-cyan;
    text-color:                 @hud-bg;
    padding:                    2px 8px;
}

entry {
    background-color:           transparent;
    text-color:                 @hud-text;
    placeholder:                "search applications";
    placeholder-color:          @hud-text-muted;
    vertical-align:             0.5;
}

case-indicator {
    background-color:           transparent;
    text-color:                 @hud-text-muted;
}

message {
    background-color:           #06111ae8;
    background-image:           linear-gradient(to bottom, #19d3ff17, #06111ae8, #030b12e8);
    border:                     1px;
    border-color:               @hud-cyan-muted;
    padding:                    8px 10px;
}

textbox {
    background-color:           transparent;
    text-color:                 @hud-text-muted;
}

listview {
    background-color:           transparent;
    columns:                    1;
    lines:                      10;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    3px;
}

scrollbar {
    background-color:           #071b29cc;
    handle-color:               @hud-cyan-muted;
    handle-width:               3px;
    border:                     0px;
    width:                      8px;
}

element {
    background-color:           transparent;
    text-color:                 @hud-text-muted;
    orientation:                horizontal;
    border:                     0px 0px 0px 2px;
    border-color:               transparent;
    padding:                    8px 10px;
    spacing:                    12px;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @hud-text-muted;
}

element selected.normal,
element selected.active {
    background-color:           #071b29e0;
    background-image:           linear-gradient(to right, #19d3ff33, #071b29e8, #030b1200);
    text-color:                 @hud-text;
    border-color:               @hud-cyan;
}

element normal.active,
element alternate.active {
    background-color:           transparent;
    text-color:                 @hud-cyan;
}

element selected.urgent {
    background-color:           #190914f2;
    background-image:           linear-gradient(to right, #ff3b6b38, #190914f2, #030b1200);
    text-color:                 @hud-alert;
    border-color:               @hud-alert;
}

element-icon {
    background-color:           transparent;
    size:                       24px;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
}
