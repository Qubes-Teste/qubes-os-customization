# Managed by qubes-os-customization Salt formula. Local changes are overwritten.
[Desktop Entry]
Name=Qubes HUD (i3)
Comment=Qubes trusted HUD session using official packaged i3
Exec=/usr/bin/env QT_QPA_PLATFORMTHEME=gtk3 /usr/bin/i3
TryExec=/usr/bin/i3
Type=XSession
X-LightDM-DesktopName=qubes-hud
DesktopNames=i3
Keywords=qubes;tiling;hud;i3;windowmanager;
