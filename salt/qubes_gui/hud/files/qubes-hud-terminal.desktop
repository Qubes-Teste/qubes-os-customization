# Qubes HUD managed file. Owner: salt/qubes_gui/hud.
[Desktop Entry]
Type=Application
Name={{ title }}
Comment=Read-only system stream; select text and press Ctrl+Shift+C to copy
Exec=/usr/bin/flock --nonblock --conflict-exit-code 0 --close /run/user/{{ desktop_uid }}/qubes-hud-terminals/{{ view }}.lock /usr/bin/python3 -B /usr/local/libexec/qubes-hud/hud-bindings --view {{ view }} --background
Icon=utilities-terminal
Terminal=false
StartupNotify=false
StartupWMClass={{ wmclass }}
Categories=System;Monitor;
OnlyShowIn=i3;I3;
