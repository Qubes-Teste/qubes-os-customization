# Qubes HUD managed file. Owner: salt/qubes_gui/hud.
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (18, 48)
    width = 360
    height = (0, 160)
    notification_limit = 5
    gap_size = 8

    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#19d3ff"
    separator_color = frame
    corner_radius = 0

    sort = yes
    idle_threshold = 120
    font = Noto Sans Mono 9
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 180
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    dmenu = /usr/bin/rofi -dmenu -theme /usr/share/rofi/themes/qubes-hud.rasi
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#06111aee"
    foreground = "#7bb9c7"
    frame_color = "#116b86"
    highlight = "#116b86, #19d3ff, #d9faff"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#071722ec"
    foreground = "#d9faff"
    frame_color = "#19d3ff"
    highlight = "#116b86, #19d3ff, #d9faff"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#190914f8"
    foreground = "#ffffff"
    frame_color = "#ff3b6b"
    highlight = "#8f1738, #ff3b6b, #ffffff"
    timeout = 0
    default_icon = dialog-warning
