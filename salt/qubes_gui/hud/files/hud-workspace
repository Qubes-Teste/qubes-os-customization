#!/usr/bin/python3
# Qubes HUD managed file. Owner: salt/qubes_gui/hud.
"""Open the HUD layout once, or supply native i3bar workspace buttons."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time

HERE = Path(__file__).resolve().parent
MARK = 'qubes-hud-workspace'
CLASSES = {'bindings': 'QubesHudBindings', 'dom0': 'QubesHudDom0Logs',
           'xen': 'QubesHudXenLogs', 'top': 'QubesHudTop',
           'xentop': 'QubesHudXentop', 'cgtop': 'QubesHudCgtop',
           'terminal': 'QubesHudTerminal', 'manager': 'Qube Manager'}
QUBE_PROFILE = Path('/etc/qubes-hud/qube-workspace.json')
QUBE_CLASSES = {'browser': 'HudQubeBrowser', 'top': 'HudQubeTermTop',
                'bottom': 'HudQubeTermBottom', 'files': 'Thunar'}


def walk(node):
    yield node
    for child in node.get('nodes', []) + node.get('floating_nodes', []):
        yield from walk(child)


def identify(node):
    properties = node.get('window_properties') or {}
    for view, wmclass in CLASSES.items():
        if view == 'manager':
            if properties.get('instance') == 'qubes-hud-manager':
                return view  # The official Manager's class is translated.
        elif (properties.get('class') == wmclass
              and (properties.get('window_role') == 'qubes-hud-' + view
                   or properties.get('instance') == 'qubes-hud-' + view)):
            return view
    return None


def commands():
    result = {'bindings': ['/usr/bin/python3', '-B', str(HERE / 'hud-bindings'),
                           '--background']}
    for view in ('dom0', 'xen', 'top', 'xentop', 'cgtop'):
        name = view + '-logs' if view in ('dom0', 'xen') else view
        result[view] = ['/usr/bin/gtk-launch', 'qubes-hud-' + name]
    result['terminal'] = ['/usr/bin/xfce4-terminal', '--disable-server',
        '--class=QubesHudTerminal', '--role=qubes-hud-terminal', '--title=Terminal',
        '--dynamic-title-mode=none', '--hide-menubar', '--hide-toolbar',
        '--font=Noto Sans Mono 8', '--working-directory=' + str(Path.home())]
    result['manager'] = ['/usr/bin/qubes-qube-manager', '-name', 'qubes-hud-manager']
    return result


def layout():
    def slot(view, percent):
        match = {'class': '^' + CLASSES[view] + '$', 'window_type': 'normal'}
        if view == 'manager':
            del match['class']
        key = 'window_role' if view in ('bindings', 'terminal') else 'instance'
        match[key] = '^qubes-hud-' + view + '$'
        return {'type': 'con', 'name': view, 'percent': percent,
                'marks': [MARK + '-' + view], 'swallows': [match]}
    return {'type': 'con', 'layout': 'splith', 'marks': [MARK], 'nodes': [
        slot('bindings', .18),
        {'type': 'con', 'layout': 'splitv', 'percent': .50, 'nodes': [
            {'type': 'con', 'layout': 'splith', 'percent': .50,
             'nodes': [slot(view, .25) for view in ('terminal', 'top', 'xentop', 'cgtop')]},
            slot('manager', .50)]},
        slot('dom0', .16), slot('xen', .16)]}


def ipc(command, *, query=False):
    argv = ['/usr/bin/i3-msg'] + (['-t', command] if query else [command])
    result = json.loads(subprocess.check_output(argv, timeout=3))
    if not query and not all(item.get('success') for item in result):
        raise RuntimeError('i3 rejected a HUD layout command')
    return result


def qube_profile():
    try:
        fd = os.open(QUBE_PROFILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None  # This optional preset is disabled on a normal HUD install.
    with os.fdopen(fd) as source:
        info = os.fstat(source.fileno())
        parent = QUBE_PROFILE.parent.lstat()
        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_gid != 0
                or stat.S_IMODE(parent.st_mode) != 0o755
                or not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) != 0o644 or info.st_nlink != 1):
            raise RuntimeError('Unexpected qube workspace profile ownership or type')
        profile = json.loads(source.read(1024))
    if (not isinstance(profile, dict) or set(profile) != {'name', 'workspace'}
            or not isinstance(profile['name'], str)
            or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_.-]{0,30}', profile['name'])
            or profile['name'] in {'dom0', 'Domain-0', 'none', 'default'}
            or profile['name'].endswith('-dm') or type(profile['workspace']) is not int
            or profile['workspace'] != 2):
        raise RuntimeError('Invalid qube workspace profile')
    return profile


def qube_layout(name):
    mark = MARK + '-qube-' + name
    def slot(view, percent):
        return {'type': 'con', 'name': view, 'percent': percent,
                'marks': [mark + '-' + view], 'swallows': [{
                    'class': '^' + re.escape(name + ':' + QUBE_CLASSES[view]) + '$'}]}
    return {'type': 'con', 'layout': 'splith', 'nodes': [slot('browser', .4),
        {'type': 'con', 'layout': 'splitv', 'percent': .3,
         'nodes': [slot('top', .5), slot('bottom', .5)]}, slot('files', .3)]}


def launch_qube(profile, runtime, prepare):
    name, workspace = profile['name'], str(profile['workspace'])
    mark = MARK + '-qube-' + name
    marks = {mark, *(mark + '-' + view for view in QUBE_CLASSES)}
    tree = ipc('get_tree', query=True)
    workspaces = [node for node in walk(tree) if node['type'] == 'workspace']
    existing = next((node for node in workspaces if any(
        marks.intersection(child.get('marks', [])) for child in walk(node))), None)
    if existing is not None:
        if prepare:
            return  # Keep user changes, even when the group has moved elsewhere.
        ipc('workspace --no-auto-back-and-forth ' + json.dumps(existing['name']))
    else:
        def wmclass(node):
            return (node.get('window_properties') or {}).get('class', '')
        target = next((node for node in workspaces if node.get('num') == profile['workspace']), None)
        if any(node.get('window') and not wmclass(node).startswith(name + ':')
               for node in (walk(target) if target else [])):
            raise RuntimeError('Workspace 2 is occupied; existing windows left in place')
        if any(wmclass(child).startswith(name + ':') for node in workspaces
               if node is not target for child in walk(node)):
            raise RuntimeError('Qube windows are already elsewhere; layout left in place')
        previous = next(node['id'] for node in walk(tree) if node.get('focused'))
        try:
            with tempfile.TemporaryDirectory(prefix='qubes-hud-layout-', dir=runtime) as directory:
                path = Path(directory) / 'layout.json'
                path.write_text(json.dumps(qube_layout(name)))
                ipc('workspace --no-auto-back-and-forth number ' + workspace)
                if target:
                    ipc(f'[con_id={target["id"]}] focus')
                ipc('append_layout ' + json.dumps(str(path)))
            current = ipc('get_tree', query=True)
            leaves = marks - {mark}
            current_target = next(node for node in walk(current)
                                  if node['type'] == 'workspace' and node.get('num') == profile['workspace'])
            groups = [node for node in current_target['nodes'] if node['type'] == 'con'
                      and len(node.get('nodes', [])) == 3
                      and leaves <= {m for child in walk(node) for m in child.get('marks', [])}]
            if len(groups) != 1:
                raise RuntimeError('Expected one qube layout group')
            group = groups[0]
            ipc(f'[con_id={group["id"]}] mark --add {mark}')
            group_ids = {node['id'] for node in walk(group)}
            # Adopt windows that arrived before append_layout. Later arrivals
            # are swallowed natively by i3; no guest command is repeated.
            for view, cls in QUBE_CLASSES.items():
                candidates = [node for node in walk(current) if node['id'] not in group_ids
                              and wmclass(node) == name + ':' + cls]
                slot = next(node for node in walk(group) if mark + '-' + view in node.get('marks', []))
                if len(candidates) == 1 and not wmclass(slot) and slot.get('swallows'):
                    old = candidates[0]['id']
                    # The placeholder XID disappears on swallow. Guard both
                    # operations atomically against a concurrently mapped app.
                    empty = f'[con_id={slot["id"]} id={slot["window"]}]'
                    ipc(f'{empty} swap container with con_id {old}')
                    placeholder = next(node for node in walk(ipc('get_tree', query=True))
                                       if node['id'] == slot['id'])
                    if wmclass(placeholder) or not placeholder.get('swallows'):
                        raise RuntimeError('Expected an empty qube layout placeholder')
                    ipc(empty + ' kill')
                    ipc(f'[con_id={old}] mark --add {mark}-{view}')
        finally:
            if prepare:
                ipc(f'[con_id={previous}] focus')
    if not prepare:
        subprocess.run(['/usr/bin/qvm-start', '--skip-if-running', name], check=True, timeout=120)


def workspace_buttons(workspaces):
    """Preserve i3's real state; absent defaults are only clickable bar entries."""
    result = list(workspaces)
    present = {item['num'] for item in workspaces}
    result.extend({'name': str(number), 'num': number}
                  for number in range(1, 6) if number not in present)
    # Numbered workspaces first; retain i3's order among named workspaces.
    return sorted(result, key=lambda item: (item['num'] < 0, item['num']))


def buttons():
    def stop(signum, frame):
        raise SystemExit(0)

    handlers = {sig: signal.signal(sig, stop)
                for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    child = None
    try:
        # i3-msg hides the subscribe acknowledgement. The automatic first tick
        # establishes subscription before the first query, so no change is lost.
        child = subprocess.Popen(
            ['/usr/bin/i3-msg', '-m', '-t', 'subscribe', '["workspace","output","tick"]'],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
        for line in child.stdout:
            event = json.loads(line)
            if 'first' in event and not event['first']:
                continue  # Other clients' ticks do not change workspace state.
            data = workspace_buttons(ipc('get_workspaces', query=True))
            print(json.dumps(data, separators=(',', ':')), flush=True)
        raise RuntimeError('i3 workspace subscription ended')
    except BrokenPipeError:
        # Prevent interpreter shutdown from flushing again into a closed bar.
        with open(os.devnull, 'w') as sink:
            os.dup2(sink.fileno(), sys.stdout.fileno())
    finally:
        if child is not None:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=1)
            child.stdout.close()
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--workspace', type=int, choices=range(1, 11), default=1)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--buttons', action='store_true',
                        help='stream workspace buttons to i3bar (i3 4.23 or newer)')
    parser.add_argument('--qube', action='store_true', help='start or focus the optional qube preset')
    parser.add_argument('--prepare', action='store_true', help='prepare qube slots without starting or focusing')
    args = parser.parse_args()
    if args.prepare and not args.qube:
        parser.error('--prepare requires --qube')
    profile = qube_profile() if args.qube else None
    if args.qube and profile is None:
        return
    for program in {command[0] for command in commands().values()} | {'/usr/bin/i3-msg'}:
        if not Path(program).is_file() or not os.access(program, os.X_OK):
            raise RuntimeError('Required stock executable unavailable: ' + program)
    if not (HERE / 'hud-bindings').is_file():
        raise RuntimeError('Shared HUD window helper is unavailable')
    slots = [node for node in walk(layout()) if node.get('swallows')]
    if len(slots) != 8 or {node['name'] for node in slots} != set(CLASSES):
        raise RuntimeError('Invalid HUD workspace layout')
    if args.check:
        print('HUD workspace layout and stock launch commands verified')
        return
    if args.buttons:
        buttons()
        return
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError('A private, owned XDG_RUNTIME_DIR is required')
    display = os.environ.get('DISPLAY', '')
    if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', display):
        raise RuntimeError('A local X11 display is required')
    lock = runtime / ('qubes-hud-workspace-' + display[1:].split('.')[0] + '.lock')
    fd = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
            raise RuntimeError('Unexpected HUD workspace lock file')
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        if args.qube:
            launch_qube(profile, runtime, args.prepare)
        else:
            launch(str(args.workspace), runtime)
    finally:
        os.close(fd)


def launch(workspace, runtime):
    tree = ipc('get_tree', query=True)
    if any(MARK in node.get('marks', []) for node in walk(tree)):
        return  # Repeated startup preserves the user's arrangement.
    target = next((node for node in walk(tree)
                   if node['type'] == 'workspace' and node['name'] == workspace), None)
    existing = {}
    for node in walk(target) if target else []:
        if not node.get('window'):
            continue
        view = identify(node)
        if view not in ('bindings', 'dom0', 'xen') or view in existing or node.get('fullscreen_mode'):
            print('HUD workspace is occupied; existing windows left in place.')
            return
        existing[view] = node['id']
    # Do not create a second layout around panes already open elsewhere.
    owned_ids = set(existing.values())
    if any(node.get('window') and identify(node)
           and node['id'] not in owned_ids for node in walk(tree)):
        print('HUD applications are already open elsewhere; layout left in place.')
        return
    previous = next(node['id'] for node in walk(tree) if node.get('focused'))
    try:
        with tempfile.TemporaryDirectory(prefix='qubes-hud-layout-', dir=runtime) as directory:
            path = Path(directory) / 'layout.json'
            path.write_text(json.dumps(layout()))
            ipc('workspace number ' + workspace)
            if target:
                ipc('[con_id=' + str(target['id']) + '] focus')
            ipc('append_layout ' + json.dumps(str(path)))
        current = ipc('get_tree', query=True)
        # i3 preserves leaf marks from JSON, but drops marks on split containers.
        slot_marks = {MARK + '-' + view for view in CLASSES}
        groups = [node for node in walk(current)
                  if node['type'] == 'con' and len(node.get('nodes', [])) == 4
                  and slot_marks <= {mark for child in walk(node)
                                     for mark in child.get('marks', [])}]
        if len(groups) != 1:
            raise RuntimeError('Expected one newly appended HUD layout')
        ipc(f'[con_id={groups[0]["id"]}] mark --add {MARK}')
        for view, old_id in existing.items():
            slot = next(node for node in walk(current) if MARK + '-' + view in node.get('marks', []))
            ipc(f'[con_id={old_id}] swap container with con_id {slot["id"]}')
            placeholder = next(node for node in walk(ipc('get_tree', query=True)) if node['id'] == slot['id'])
            if (placeholder.get('window_properties') or {}).get('class') or not placeholder.get('swallows'):
                raise RuntimeError('Expected an empty layout placeholder')
            ipc(f'[con_id={slot["id"]}] kill')
        for view, argv in commands().items():
            if view not in existing:
                subprocess.Popen(argv, stdin=subprocess.DEVNULL, start_new_session=True)
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            current = ipc('get_tree', query=True)
            group = next((node for node in walk(current) if MARK in node.get('marks', [])), None)
            if group and {identify(node) for node in walk(group)} - {None} == set(CLASSES):
                for node in walk(group):
                    for mark in node.get('marks', []):
                        if mark in slot_marks:
                            ipc('unmark ' + mark)
                return
            time.sleep(.1)
        raise RuntimeError('A HUD application did not fill its slot; inspect workspace ' + workspace)
    finally:
        # Normal startup and the explicit preview restore the prior focus.
        subprocess.run(['/usr/bin/i3-msg', f'[con_id={previous}] focus'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit('HUD workspace: ' + str(error))
