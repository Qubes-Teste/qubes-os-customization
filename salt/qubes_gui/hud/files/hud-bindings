def bind(library, name, result, *args):
    function = getattr(library, name)
    function.restype, function.argtypes = result, args
    return function


for name, result, args in [
    ("gtk_init_check", I, (P, P)),
    ("gtk_window_new", P, (I,)),
    ("gtk_window_set_title", None, (P, S)),
    ("gtk_window_set_wmclass", None, (P, S, S)),
    ("gtk_window_set_role", None, (P, S)),
    ("gtk_window_set_default_size", None, (P, I, I)),
    ("gtk_window_set_decorated", None, (P, I)),
    ("gtk_box_new", P, (I, I)),
    ("gtk_box_pack_start", None, (P, P, I, I, U)),
    ("gtk_container_add", None, (P, P)),
    ("gtk_container_set_border_width", None, (P, U)),
    ("gtk_label_new", P, (S,)),
    ("gtk_label_set_text", None, (P, S)),
    ("gtk_label_set_xalign", None, (P, C.c_float)),
    ("gtk_label_set_line_wrap", None, (P, I)),
    ("gtk_label_set_line_wrap_mode", None, (P, I)),
    ("gtk_label_set_width_chars", None, (P, I)),
    ("gtk_label_set_max_width_chars", None, (P, I)),
    ("gtk_scrolled_window_new", P, (P, P)),
    ("gtk_scrolled_window_set_policy", None, (P, I, I)),
    ("gtk_search_entry_new", P, ()),
    ("gtk_entry_set_placeholder_text", None, (P, S)),
    ("gtk_entry_get_text", S, (P,)),
    ("gtk_widget_get_style_context", P, (P,)),
    ("gtk_style_context_add_class", None, (P, S)),
    ("gtk_widget_set_hexpand", None, (P, I)),
    ("gtk_widget_set_valign", None, (P, I)),
    ("gtk_widget_set_visible", None, (P, I)),
    ("gtk_widget_show_all", None, (P,)),
    ("gtk_widget_grab_focus", None, (P,)),
    ("gtk_widget_get_window", P, (P,)),
    ("gdk_x11_window_get_xid", C.c_ulong, (P,)),
    ("gtk_css_provider_new", P, ()),
    ("gtk_css_provider_load_from_data", I, (P, S, C.c_ssize_t, P)),
    ("gtk_style_context_add_provider_for_screen", None, (P, P, U)),
    ("gdk_screen_get_default", P, ()),
    ("gtk_main", None, ()),
    ("gtk_main_quit", None, ()),
]:
    bind(gtk, name, result, *args)

CALLBACK = C.CFUNCTYPE(None, P, P)
connect = bind(gobject, "g_signal_connect_data", C.c_ulong, P, S, CALLBACK, P, P, I)
unref = bind(gobject, "g_object_unref", None, P)
TIMER_CALLBACK = C.CFUNCTYPE(I, P)
timeout_add = bind(glib, "g_timeout_add", U, U, TIMER_CALLBACK, P)
source_remove = bind(glib, "g_source_remove", I, U)

