def style(widget, name):
    gtk.gtk_style_context_add_class(gtk.gtk_widget_get_style_context(widget), name.encode())
    return widget


def label(text, css_class, width=None):
    widget = style(gtk.gtk_label_new(text.encode()), css_class)
    gtk.gtk_label_set_xalign(widget, 0.0)
    gtk.gtk_label_set_line_wrap(widget, 1)
    gtk.gtk_label_set_line_wrap_mode(widget, 2)  # PANGO_WRAP_WORD_CHAR
    gtk.gtk_widget_set_valign(widget, 1)  # GTK_ALIGN_START
    if width is not None:
        gtk.gtk_label_set_width_chars(widget, width)
        gtk.gtk_label_set_max_width_chars(widget, width)
    else:
        gtk.gtk_label_set_max_width_chars(widget, 42)
        gtk.gtk_widget_set_hexpand(widget, 1)
    return widget


def box(vertical=True, spacing=0):
    return gtk.gtk_box_new(int(vertical), spacing)


def pack(parent, child, expand=False):
    gtk.gtk_box_pack_start(parent, child, int(expand), 1, 0)
    return child


def load_data(path):
    with pathlib.Path(path).open('rb') as stream:
        raw = stream.read(262145)
    if len(raw) > 262144:
        raise ValueError("Shortcut data exceeds 256 KiB")
    data = json.loads(raw)
    if not isinstance(data, dict) or not isinstance(data.get("sections"), list):
        raise ValueError("Expected an object with a sections array")
    count = 0
    for section in data["sections"]:
        if not isinstance(section, dict) or not isinstance(section.get("title"), str) or not isinstance(section.get("entries"), list):
            raise ValueError("Each section needs a title and entries")
        for entry in section["entries"]:
            if not isinstance(entry, dict) or not all(isinstance(entry.get(key), str) for key in ("keys", "description")):
                raise ValueError("Each entry needs keys and description strings")
            template = entry.get("keys_template")
            if template is not None:
                if not isinstance(template, str):
                    raise ValueError("Keyboard templates must be strings")
                remainder = re.sub(r"\{(?:k[0-9]{1,3}|s_minus)\}", "", template)
                codes = [int(code) for code in re.findall(r"\{k([0-9]+)\}", template)]
                if "{" in remainder or "}" in remainder or any(not 8 <= code <= 255 for code in codes):
                    raise ValueError("Invalid physical key in keyboard template")
            count += 1
    if count > 512 or len(data["sections"]) > 32:
        raise ValueError("Too many shortcut entries or sections")
    return data


def acquire_instance(background):
    """Hold one per-user/display flock; focus an existing window on manual launch."""
    runtime = pathlib.Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError('A private, owned XDG_RUNTIME_DIR is required')
    display = os.environ.get('DISPLAY', '')
    if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', display):
        raise RuntimeError('A local X11 DISPLAY is required')
    token = hashlib.sha256(display.split('.', 1)[0].encode()).hexdigest()[:16]
    fd = os.open(runtime / ('qubes-hud-bindings-' + token + '.lock'),
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    keep = False
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1:
            raise RuntimeError('Unexpected HUD Bindings lock file')
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            keep = True
            return fd
        except BlockingIOError:
            if not background:
                deadline = time.monotonic() + 2
                while time.monotonic() < deadline:
                    tree = json.loads(subprocess.check_output(['/usr/bin/i3-msg', '-t', 'get_tree'], timeout=2))
                    pending = [tree]
                    while pending:
                        node = pending.pop()
                        if node.get('window_properties', {}).get('class') == 'QubesHudBindings':
                            subprocess.run(['/usr/bin/i3-msg', f'[con_id={int(node["id"])}] focus'],
                                           check=True, stdout=subprocess.DEVNULL, timeout=2)
                            return None
                        pending.extend(node.get('nodes', []) + node.get('floating_nodes', []))
                    time.sleep(.1)
            return None
    finally:
        # The successful owner keeps its descriptor open for its whole lifetime.
        if not keep:
            os.close(fd)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data", type=pathlib.Path,
                        default=pathlib.Path(__file__).resolve().with_name('bindings.json'))
    parser.add_argument("--check", action="store_true", help="Validate data and runtime symbols without opening a display")
    parser.add_argument("--background", action="store_true", help="Do not focus an already-open reference")
    args = parser.parse_args()
    data = load_data(args.data)
    if args.check:
        KeyboardLayout(check_only=True).close()
        print('HUD Bindings data and stock GTK3/GLib/X11 runtime symbols verified')
        return
    if not gtk.gtk_init_check(None, None):
        raise RuntimeError("GTK could not open the selected display")
    instance = acquire_instance(args.background)
    if instance is None:
        return
    try:
        run_window(data, present=not args.background)
    finally:
        os.close(instance)


def run_window(data, *, present=False):
    provider = gtk.gtk_css_provider_new()
    if not gtk.gtk_css_provider_load_from_data(provider, CSS, len(CSS), None):
        raise RuntimeError("GTK rejected the shortcut style")
    gtk.gtk_style_context_add_provider_for_screen(gtk.gdk_screen_get_default(), provider, 800)
    unref(provider)  # The screen retains its own reference.

    window = style(gtk.gtk_window_new(0), "shortcut-window")  # Normal managed toplevel.
    gtk.gtk_window_set_title(window, b"HUD Bindings")
    gtk.gtk_window_set_wmclass(window, b"qubes-hud-bindings", b"QubesHudBindings")
    gtk.gtk_window_set_role(window, b"qubes-hud-bindings")
    gtk.gtk_window_set_decorated(window, 1)
    gtk.gtk_window_set_default_size(window, 520, 900)
    body = box(spacing=15)
    gtk.gtk_container_set_border_width(body, 20)
    gtk.gtk_container_add(window, body)
    header = pack(body, box(spacing=6))
    pack(header, label("HUD Bindings", "heading"))
    subtitle = pack(header, label("Reading active keyboard…", "subtitle"))
    search = pack(body, gtk.gtk_search_entry_new())
    gtk.gtk_entry_set_placeholder_text(search, b"Find a shortcut or action...")
    scroller = pack(body, gtk.gtk_scrolled_window_new(None, None), True)
    gtk.gtk_scrolled_window_set_policy(scroller, 2, 1)  # Never horizontal; vertical automatic.
    content = box(spacing=15)
    gtk.gtk_container_add(scroller, content)
    groups = []
    for section in data["sections"]:
        group = pack(content, style(box(spacing=7), "card"))
        pack(group, label(section["title"].upper(), "section-title"))
        rows = []
        for entry in section["entries"]:
            row = pack(group, style(box(True, 5), "card-row"))
            key_label = pack(row, label(entry["keys"], "keys"))
            pack(row, label(entry["description"], "description"))
            haystack = " ".join((section["title"], entry["keys"], entry["description"])).casefold()
            rows.append({"widget": row, "haystack": haystack, "label": key_label,
                         "entry": entry, "section": section["title"]})
        groups.append((group, rows))
    footer = pack(body, label("", "footer"))
    callbacks = []  # Keep every C callback alive until gtk_main returns.

    @CALLBACK
    def update_filter(_widget, _data):
        terms = gtk.gtk_entry_get_text(search).decode().casefold().split()
        visible = 0
        for group, rows in groups:
            group_visible = False
            for row in rows:
                match = all(term in row["haystack"] for term in terms)
                gtk.gtk_widget_set_visible(row["widget"], int(match))
                visible += int(match)
                group_visible |= match
            gtk.gtk_widget_set_visible(group, int(group_visible))
        text = f"{visible} shortcuts  ·  Type to filter  ·  Scroll to explore"
        gtk.gtk_label_set_text(footer, text.encode())

    @CALLBACK
    def close_window(_widget, _data):
        gtk.gtk_main_quit()

    keycodes = sorted({int(code) for _group, rows in groups for row in rows
                       for code in re.findall(r"\{k([0-9]+)\}", row["entry"].get("keys_template", ""))})
    keyboard = KeyboardLayout()
    previous = None

    @TIMER_CALLBACK
    def update_keyboard(_data):
        nonlocal previous
        try:
            state = keyboard.snapshot(keycodes)
        except (OSError, ValueError, RuntimeError) as error:
            state = {"supported": False, "name": "Keyboard unavailable", "keys": {}}
            if state != previous:
                print(f"Keyboard reference: {error}", file=sys.stderr, flush=True)
        if state == previous:
            return 1
        previous = state
        if state["supported"]:
            caption = state["name"] + " keyboard · follows active layout"
        else:
            caption = state["name"] + " · English / German supported"
        caption += "\n" + str(data.get("subtitle", "Super = Windows key · reference only"))
        gtk.gtk_label_set_text(subtitle, caption.encode())
        for _group, rows in groups:
            for row in rows:
                entry = row["entry"]
                template = entry.get("keys_template")
                keys = entry["keys"]
                if template is not None:
                    if state["supported"]:
                        keys = re.sub(r"\{(?:k([0-9]+)|(s_minus))\}",
                                      lambda match: state["keys"].get(int(match[1]), "?") if match[1]
                                      else (state.get("symbols", {}).get("minus") or "Unavailable"), template)
                    else:
                        keys = "Unavailable for this keyboard"
                gtk.gtk_label_set_text(row["label"], keys.encode())
                row["haystack"] = " ".join((row["section"], keys, entry["description"])).casefold()
        update_filter(None, None)
        return 1

    callbacks.extend((update_filter, close_window, update_keyboard))
    connect(search, b"search-changed", update_filter, None, None, 0)
    connect(window, b"destroy", close_window, None, None, 0)
    gtk.gtk_widget_show_all(window)
    update_keyboard(None)
    gtk.gtk_widget_grab_focus(search)
    focus_timer = 0
    if present:
        own_xid = gtk.gdk_x11_window_get_xid(gtk.gtk_widget_get_window(window))
        focus_deadline = time.monotonic() + 2

        @TIMER_CALLBACK
        def focus_new_window(_data):
            nonlocal focus_timer
            try:
                response = subprocess.run(['/usr/bin/i3-msg', f'[id={own_xid}] focus'],
                                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                          timeout=1, check=False)
                result = json.loads(response.stdout)
                if result and all(item.get('success') for item in result):
                    focus_timer = 0
                    return 0
            except (OSError, ValueError, subprocess.SubprocessError):
                pass
            if time.monotonic() >= focus_deadline:
                print('HUD Bindings opened; i3 did not accept the focus request.', file=sys.stderr)
                focus_timer = 0
                return 0
            return 1

        callbacks.append(focus_new_window)
        focus_timer = timeout_add(100, focus_new_window, None)
    timer = timeout_add(1000, update_keyboard, None)
    try:
        gtk.gtk_main()
    finally:
        source_remove(timer)
        if focus_timer:
            source_remove(focus_timer)
        keyboard.close()


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"Shortcut reference: {error}", file=sys.stderr)
        sys.exit(1)
