# Keep all managed application windows in the trusted HUD frame. This also
# restores a server-side titlebar for clients that request no decoration.
default_border normal 3
default_floating_border normal 3
for_window [class=".*"] border normal 3

gaps inner 32
gaps outer 12
smart_gaps on

# Use these keys for focus, movement, and resize directions when reaching for
# the arrows is not convenient.
set $up l
set $down k
set $left j
set $right semicolon

# Use Mouse+$mod to drag floating windows to their wanted position.
floating_modifier $mod

# Drag tiled windows directly by their title bars, or from anywhere while
# holding $mod. Dropping near an edge selects the new tiled position.
tiling_drag modifier titlebar
tiling_drag swap_modifier Shift

# Start a terminal in the domain of the currently active window.
bindcode $mod+36 exec $terminal
bindcode $mod+Shift+36 exec $console

# Always start a trusted dom0 terminal, regardless of the focused qube.
# Physical keycode 28 is T on the supported German and US keyboard layouts.
bindcode Control+Mod1+28 exec --no-startup-id $dom0_terminal

# Kill focused window.
bindcode $mod+Shift+24 kill

# Standard desktop fallback that does not require knowing the i3 modifier.
bindsym Mod1+F4 kill

# Start the HUD application launcher.
bindcode $mod+40 exec --no-startup-id rofi -show drun

# Preserve the standard Qubes application menu.
bindcode $mod+Shift+40 exec --no-startup-id qubes-app-menu

# Change focus.
bindcode $mod+44 focus left
bindcode $mod+45 focus down
bindcode $mod+46 focus up
bindcode $mod+47 focus right

# Alternatively, use the cursor keys.
bindcode $mod+113 focus left
bindcode $mod+116 focus down
bindcode $mod+111 focus up
bindcode $mod+114 focus right

# Move focused window.
bindcode $mod+Shift+44 move left
bindcode $mod+Shift+45 move down
bindcode $mod+Shift+46 move up
bindcode $mod+Shift+47 move right

# Alternatively, use the cursor keys.
bindcode $mod+Shift+113 move left
bindcode $mod+Shift+116 move down
bindcode $mod+Shift+111 move up
bindcode $mod+Shift+114 move right

# Split in horizontal orientation.
bindcode $mod+43 split h

# Split in vertical orientation.
bindcode $mod+55 split v

# Enter fullscreen mode for the focused container.
bindcode $mod+41 fullscreen toggle

# Change container layout (stacked, tabbed, toggle split).
bindcode $mod+39 layout stacking
bindcode $mod+25 layout tabbed
bindcode $mod+26 layout toggle split

# Toggle tiling / floating.
bindcode $mod+Shift+65 floating toggle

# Change focus between tiling / floating windows.
bindcode $mod+65 focus mode_toggle

# Focus the parent container.
bindcode $mod+38 focus parent

# Move the currently focused window to the scratchpad.
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
bindsym $mod+minus scratchpad show

# Define default workspace names.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace.
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev
bindcode $mod+10 workspace number $ws1
bindcode $mod+11 workspace number $ws2
bindcode $mod+12 workspace number $ws3
bindcode $mod+13 workspace number $ws4
bindcode $mod+14 workspace number $ws5
bindcode $mod+15 workspace number $ws6
bindcode $mod+16 workspace number $ws7
bindcode $mod+17 workspace number $ws8
bindcode $mod+18 workspace number $ws9
bindcode $mod+19 workspace number $ws10

# Move focused container to workspace.
bindcode $mod+Shift+10 move container to workspace number $ws1
bindcode $mod+Shift+11 move container to workspace number $ws2
bindcode $mod+Shift+12 move container to workspace number $ws3
bindcode $mod+Shift+13 move container to workspace number $ws4
bindcode $mod+Shift+14 move container to workspace number $ws5
bindcode $mod+Shift+15 move container to workspace number $ws6
bindcode $mod+Shift+16 move container to workspace number $ws7
bindcode $mod+Shift+17 move container to workspace number $ws8
bindcode $mod+Shift+18 move container to workspace number $ws9
bindcode $mod+Shift+19 move container to workspace number $ws10

# Reload configuration and restart i3 in place.
bindcode $mod+Shift+54 reload
bindcode $mod+Shift+27 restart

# Exit i3 (logs out of the X session).
bindcode $mod+Shift+26 exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize window (the mouse can also be used).
mode "resize" {
        bindcode 44 resize shrink width 10 px or 10 ppt
        bindcode 45 resize grow height 10 px or 10 ppt
        bindcode 46 resize shrink height 10 px or 10 ppt
        bindcode 47 resize grow width 10 px or 10 ppt

        bindcode 113 resize shrink width 10 px or 10 ppt
        bindcode 116 resize grow height 10 px or 10 ppt
        bindcode 111 resize shrink height 10 px or 10 ppt
        bindcode 114 resize grow width 10 px or 10 ppt

        # Back to normal: Enter, Escape, or $mod+r.
        bindcode 36 mode "default"
        bindcode 9 mode "default"
        bindcode $mod+27 mode "default"
}

bindcode $mod+27 mode "resize"

# Top HUD bar with Qubes' trusted status command and system tray.
bar {
        position top
        height 30
        tray_output primary
        status_command qubes-i3status
        font $font

        colors {
                background         #000000
                statusline         #d9faff
                separator          #116b86

                # class            border   background text
                focused_workspace  #19d3ff  #071b29    #d9faff
                active_workspace   #116b86  #081722    #7bb9c7
                inactive_workspace #0d4052  #06111a    #517482
                urgent_workspace   #ff3b6b  #2a0a17    #ffffff
        }
}

# Draw the code-native HUD background on every i3 start/reload.
exec_always --no-startup-id feh --no-fehbg --bg-fill /usr/share/backgrounds/qubes-hud.png

# Restore this user's configured desktop keyboard layout. On Qubes this is
# normally saved by Xfce; the helper falls back to the system X11 defaults.
exec --no-startup-id /usr/local/libexec/qubes-hud/apply-keyboard-layout

# Avoid screen-size fingerprinting.
for_window [title="Tor Browser"] floating enable
for_window [instance="zenity"] floating enable

# Start all XDG autostart entries; transient VMs depend on this.
exec --no-startup-id $desktop_autostart

# Start dunst explicitly; bus activation cannot select among multiple providers.
exec --no-startup-id dunst

