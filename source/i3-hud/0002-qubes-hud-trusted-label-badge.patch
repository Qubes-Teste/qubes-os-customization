+
+/* Draw a trusted label-colored line over the already-painted title bar. Two
+ * low-opacity strokes form a restrained halo beneath the solid core. All three
+ * fade toward the title while retaining the full label color at the right. */
+static void draw_qubes_label_line(surface_t *surface, color_t color,
+                                  int x, int y, int width, int line_height,
+                                  int decoration_height) {
+    if (surface->id == XCB_NONE || width <= 0 || line_height <= 0 ||
+        decoration_height <= 0) {
+        return;
+    }
+
+    const double line_width = min(width, line_height);
+    const double start_x = x + (line_width / 2.0);
+    const double end_x = x + width - (line_width / 2.0);
+    const double center_y = y + (line_height / 2.0);
+    const double requested_widths[] = {
+        logical_px(9), logical_px(5), line_width};
+    const double opacity_multipliers[] = {0.08, 0.16, 1.0};
+    const size_t stroke_count = sizeof(requested_widths) / sizeof(requested_widths[0]);
+
+    cairo_save(surface->cr);
+    cairo_set_operator(surface->cr, CAIRO_OPERATOR_OVER);
+    cairo_set_line_cap(surface->cr, CAIRO_LINE_CAP_ROUND);
+    for (size_t i = 0; i < stroke_count; i++) {
+        const double stroke_width = min((double)width,
+                                        min((double)decoration_height,
+                                            requested_widths[i]));
+        cairo_pattern_t *gradient = cairo_pattern_create_linear(start_x, center_y,
+                                                                 end_x, center_y);
+        cairo_pattern_set_extend(gradient, CAIRO_EXTEND_PAD);
+        cairo_pattern_add_color_stop_rgba(gradient, 0.0,
+                                          color.red, color.green, color.blue,
+                                          color.alpha * 0.04 * opacity_multipliers[i]);
+        cairo_pattern_add_color_stop_rgba(gradient, 1.0,
+                                          color.red, color.green, color.blue,
+                                          color.alpha * opacity_multipliers[i]);
+        cairo_set_source(surface->cr, gradient);
+        cairo_set_line_width(surface->cr, stroke_width);
+        cairo_move_to(surface->cr, start_x, center_y);
+        cairo_line_to(surface->cr, end_x, center_y);
+        cairo_stroke(surface->cr);
+        cairo_pattern_destroy(gradient);
+    }
+    CAIRO_SURFACE_FLUSH(surface->surface);
+    cairo_restore(surface->cr);
+}
