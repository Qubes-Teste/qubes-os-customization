+/*
+ * Updates the trusted Qubes label color. gui-daemon publishes one XA_CARDINAL
+ * value in 32-bit 0xRRGGBB form before the window is managed.
+ */
+void window_update_qubes_label_color(i3Window *win, xcb_get_property_reply_t *prop) {
+    win->qubes_label_color = 0;
+    win->qubes_label_color_valid = false;
+
+    if (prop == NULL ||
+        prop->type != XCB_ATOM_CARDINAL ||
+        prop->format != 32 ||
+        xcb_get_property_value_length(prop) != (int)sizeof(uint32_t) ||
+        prop->bytes_after != 0) {
+        FREE(prop);
+        return;
+    }
+
+    uint32_t raw_color;
+    memcpy(&raw_color, xcb_get_property_value(prop), sizeof(raw_color));
+    if (raw_color > 0x00ffffffU) {
+        free(prop);
+        return;
+    }
+
+    win->qubes_label_color = raw_color;
+    win->qubes_label_color_valid = true;
+    free(prop);
+}
