+ * not publish _QUBES_LABEL_COLOR. Modern windows use the trusted RGB property,
+ * including custom Qubes labels. */
+static const uint32_t qubes_label_fallback_rgb[QUBE_NUM_LABELS] = {
+    [QUBE_DOM0] = 0xf5f5f5,
+    [QUBE_RED] = 0xcc0000,
+    [QUBE_ORANGE] = 0xf57900,
+    [QUBE_YELLOW] = 0xedd400,
+    [QUBE_GREEN] = 0x73d216,
+    [QUBE_GRAY] = 0x555555,
