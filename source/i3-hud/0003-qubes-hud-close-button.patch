+/* Keep drawing and hit-testing on one geometry function. The hit target spans
+ * the complete titlebar height while its glyph remains compact and centered. */
+Rect x_qubes_hud_close_button_rect(Con *con) {
+    Rect result = {0, 0, 0, 0};
+    if (con == NULL || con->window == NULL ||
+        con_border_style(con) != BS_NORMAL ||
+        con->deco_rect.width == 0 || con->deco_rect.height == 0) {
+        return result;
+    }
+
+    const int deco_width = (int)con->deco_rect.width;
+    const int deco_height = (int)con->deco_rect.height;
+    const int hit_width = min(logical_px(26), deco_width);
+    const int min_glyph_extent = 2 * logical_px(2) + logical_px(8);
+    if (hit_width < min_glyph_extent || deco_height < min_glyph_extent) {
+        return result;
+    }
+
+    result.x = con->deco_rect.x + con->deco_rect.width - hit_width;
+    result.y = con->deco_rect.y;
+    result.width = hit_width;
+    result.height = con->deco_rect.height;
+    return result;
+}
+
+/* Draw a compact alert-colored circular close button. The larger invisible
+ * hit target returned above makes it usable without consuming the titlebar. */
+static void draw_qubes_hud_close_button(surface_t *surface, color_t color,
+                                        Rect hit_rect) {
+    if (surface->id == XCB_NONE || hit_rect.width == 0 || hit_rect.height == 0) {
+        return;
+    }
+
+    const double inset = logical_px(2);
+    const double available_extent = min((double)hit_rect.width,
+                                        (double)hit_rect.height);
+    const double diameter = min((double)logical_px(16),
+                                max(0.0, available_extent - 2.0 * inset));
+    if (diameter < logical_px(8)) {
+        return;
+    }
+
+    const double center_x = hit_rect.x + hit_rect.width / 2.0;
+    const double center_y = hit_rect.y + hit_rect.height / 2.0;
+    const double radius = diameter / 2.0;
+    const double arm = radius * 0.43;
+
+    cairo_save(surface->cr);
+    cairo_set_operator(surface->cr, CAIRO_OPERATOR_OVER);
+    cairo_arc(surface->cr, center_x, center_y, radius,
+              0.0, 2.0 * 3.14159265358979323846);
+    cairo_set_source_rgba(surface->cr, color.red, color.green, color.blue,
+                          color.alpha * 0.14);
+    cairo_fill_preserve(surface->cr);
+    cairo_set_line_width(surface->cr, max(1, logical_px(1)));
+    cairo_set_source_rgba(surface->cr, color.red, color.green, color.blue,
+                          color.alpha * 0.64);
+    cairo_stroke(surface->cr);
+
+    cairo_set_line_cap(surface->cr, CAIRO_LINE_CAP_ROUND);
+    const double stroke_widths[] = {logical_px(4), logical_px(2)};
+    const double stroke_opacities[] = {0.18, 1.0};
+    for (size_t i = 0; i < 2; i++) {
+        cairo_set_line_width(surface->cr, min(diameter / 2.0, stroke_widths[i]));
+        cairo_set_source_rgba(surface->cr, color.red, color.green, color.blue,
+                              color.alpha * stroke_opacities[i]);
+        cairo_move_to(surface->cr, center_x - arm, center_y - arm);
+        cairo_line_to(surface->cr, center_x + arm, center_y + arm);
+        cairo_move_to(surface->cr, center_x + arm, center_y - arm);
+        cairo_line_to(surface->cr, center_x - arm, center_y + arm);
+        cairo_stroke(surface->cr);
+    }
+    CAIRO_SURFACE_FLUSH(surface->surface);
+    cairo_restore(surface->cr);
+}
